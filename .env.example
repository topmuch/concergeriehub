# ---- Database (Prisma + SQLite) ----
DATABASE_URL=file:/absolute/path/to/db/custom.db

# ---- NextAuth (required for signed session JWTs) ----
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
NEXTAUTH_URL=http://localhost:3000

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Seed superadmin (AUDIT 24-e / P0-2) ----
# create-admin.cjs est CREATE-ONLY : si le compte existe déjà, le mot de
# passe n'est JAMAIS réécrit (rotation préservée). Ces vars ne servent
# qu'à la PREMIÈRE création du compte sur une base vide.
ADMIN_EMAIL=admin@qrdomotik.roomscan.pro
# Si absent à la 1re création : mot de passe aléatoire généré et affiché
# UNE FOIS dans les logs de démarrage (à changer immédiatement).
ADMIN_INITIAL_PASSWORD=

# ---- Stripe (ÉTAPE 10) ----
# Sans STRIPE_SECRET_KEY, l'abonnement tourne en MODE DÉMO :
# activation immédiate sans paiement réel (idéal en dev).
# En réel : clé secrète + secret du webhook (endpoint /api/stripe/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs optionnels des plans marketplace (upselling/premium) —
# si absent, les paiements marketplace utilisent les montants calculés.
STRIPE_PREMIUM_PRICE_ID=
STRIPE_FEATURED_PRICE_ID=

# ---- CRON externe (AUDIT 24-c) ----
# Protège POST /api/admin/trigger-daily-automations (rappels J-3/J+1,
# cron iCal). À appeler par Cron-job.org / Coolify scheduled task :
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://votre-domaine/api/admin/trigger-daily-automations
CRON_SECRET=

# ---- Redis (optionnel — rate limiting multi-instances) ----
# Absent → rate limit mémoire locale (mono-instance, suffisant Coolify).
REDIS_URL=

# ---- Push Web Push (VAPID — notifications navigateur) ----
# Générer : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votre-domaine.fr

# ---- Emails transactionnels ----
# QueueEmail fonctionne sans SMTP (outbox DB consultable dans /admin/emails).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=RoomScan <no-reply@votre-domaine.fr>
# Fournisseur API alternatif (si présent, priorisé sur SMTP)
RESEND_API_KEY=

# ---- Twilio (SMS / WhatsApp — optionnel) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# ---- Uploads ----
# Dossier des mémos vocaux (défaut : data/uploads/voice en prod Docker)
VOICE_UPLOAD_DIR=

# ---- Module « Où sortir ce soir ? » (événements temps réel du Hub invité) ----
# ⚠ État 2026 des sources :
#   • Ticketmaster Discovery → SOURCE PRINCIPALE fiable (clé gratuite instantanée)
#   • Paris open data « Que Faire à Paris » → active SANS CLÉ pour tout bien
#     en Île-de-France (aucune variable à définir)
#   • Eventbrite → a RÉVOQUÉ /v3/events/search (404 public) ; le jeton privé
#     reste valable pour la gestion organisateur mais ne renvoie plus
#     d'événements de ville. Gardé branché si Eventbrite rouvre.
#   • Bandsintown → API publique restreinte (403) hors app_id partenaires.
# Le module reste actif (configured:true) dès qu'UNE source est disponible.
# Ticketmaster Discovery API — https://developer.ticketmaster.com/products-and-docs/apis/discovery-api/v2/
TICKETMASTER_API_KEY=
# Eventbrite API v3 (jeton privé) — https://www.eventbrite.com/platform/api
EVENTBRITE_API_KEY=
# Bandsintown Public API (app_id gratuit) — https://app.swaggerhub.com/apis/Bandsintown/PublicAPI/3.0.0
BANDSINTOWN_APP_ID=
# Rayon de recherche des événements autour du logement, en km (défaut : 50)
EVENT_RADIUS_KM=50

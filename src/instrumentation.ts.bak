// =============================================================
// Runs at Next.js startup in standalone mode (PRODUCTION ONLY).
// Uses ONLY sqlite3 CLI — NO Prisma.
//
// NOTE: All Node modules are dynamically imported inside register()
// and guarded by NEXT_RUNTIME === 'nodejs' so this file can also be
// safely bundled for the Edge Runtime (where it becomes a no-op).
// =============================================================

const LOG_FILE = '/tmp/ordomotik-init.log'

function log(msg: string) {
  const ts = new Date().toISOString()
  const line = `[${ts}] ${msg}\n`
  console.log(`[db-init] ${msg}`)
  try {
    // eslint-disable-next-line @typescript-eslint/no-require-imports
    const { appendFileSync } = require('fs') as typeof import('fs')
    appendFileSync(LOG_FILE, line)
  } catch { /* ignore */ }
}

export async function register() {
  if (process.env.NEXT_RUNTIME !== 'nodejs') return
  if (process.env.NODE_ENV !== 'production') {
    console.log('[db-init] Skipped (not production)')
    return
  }

  const { execSync } = await import('child_process')
  const { existsSync, mkdirSync, writeFileSync, chmodSync, readFileSync } = await import('fs')
  const { join, dirname } = await import('path')

  log('=== ORDOMOTIK Database Initialization ===')

  // Verify sqlite3 CLI exists
  try {
    const v = execSync('/usr/bin/sqlite3 --version', { encoding: 'utf-8', stdio: 'pipe' }).trim()
    log(`sqlite3: ${v}`)
  } catch {
    log('FATAL: sqlite3 CLI not found')
    return
  }

  // Resolve the configured database file path
  const envUrl = process.env.DATABASE_URL || ''
  let dbPath: string
  if (envUrl.startsWith('file:')) dbPath = envUrl.replace(/^file:\/?\/?/, '')
  else if (envUrl.startsWith('/')) dbPath = envUrl
  else dbPath = join(process.cwd(), 'data', 'qrdomotik.db')

  // Ensure the directory exists and the file is writable via Node.js
  const dir = dirname(dbPath)
  try {
    mkdirSync(dir, { recursive: true })
    if (!existsSync(dbPath)) {
      writeFileSync(dbPath, '')
      chmodSync(dbPath, 0o666)
      log(`DB file pre-created at ${dbPath}`)
    }
  } catch (e) {
    log(`FATAL: cannot prepare DB path: ${String(e).substring(0, 200)}`)
    return
  }

  // Look for a schema.sql shipped next to the app (data/ or scripts/)
  const searchPaths = ['/app/data', '/app/scripts', join(process.cwd(), 'data'), join(process.cwd(), 'scripts')]
  let schemaPath: string | undefined
  for (const d of searchPaths) {
    const candidate = join(d, 'schema.sql')
    if (existsSync(candidate)) { schemaPath = candidate; break }
  }
  if (!schemaPath) {
    log('WARN: schema.sql not found — skipping SQL import')
    return
  }

  try {
    const sql = readFileSync(schemaPath, 'utf-8')
    execSync(`/usr/bin/sqlite3 "${dbPath}"`, { input: sql, stdio: ['pipe', 'pipe', 'pipe'], timeout: 30000 })
    log(`Schema applied from ${schemaPath}`)
    const tables = execSync(`/usr/bin/sqlite3 "${dbPath}" "SELECT COUNT(*) FROM sqlite_master WHERE type='table';"`, { encoding: 'utf-8', stdio: 'pipe' }).trim()
    log(`Tables: ${tables}`)
  } catch (e) {
    log(`FATAL: ${String(e).substring(0, 500)}`)
  }
}

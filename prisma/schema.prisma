// ==============================================================
// TABLE 36: voice_messages (Hub — répondeur vocal)
// senderType : 'guest' | 'host' | 'system'
// ==============================================================
model VoiceMessage {
  id          String   @id @default(cuid())
  propertyId  String   @map("property_id")
  senderName  String   @map("sender_name")       // nom affiché (invité ou membre de l'équipe)
  senderType  String   @default("guest") @map("sender_type") // 'guest' | 'host' | 'system'
  audioUrl    String   @map("audio_url")         // URL fichier (route /api/uploads/voice/<fichier>)
  // v4.32 — AUDIO DURABLE : copie dataURL (base64) stockée EN BASE.
  // Les fichiers disque étaient perdus à chaque redéploiement Docker
  // (dossier non garanti persistant) → 404 → « l'audio ne marche pas »
  // dans le dashboard. La lecture privilégie audioData, audioUrl reste
  // le repli pour les anciens messages. Null si fichier > plafond.
  audioData   String?  @map("audio_data")
  durationSec Int      @default(0) @map("duration_sec")  // durée en secondes (max 30)
  fileSizeKb  Int      @default(0) @map("file_size_kb")  // taille du fichier audio
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  // v4.77 « MESSAGERIE THREADÉE » — réponse de l'invité attachée au
  // vocal précis auquel elle répond (senderType='guest', replyToId =
  // id d'un vocal HÔTE). Null = message sans réponse (ex. « Contacter
  // l'hôte » classique). Validé serveur (existe + même bien + vocal hôte).
  replyToId   String?  @map("reply_to_id")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([senderType])
  @@index([isRead])
  @@index([createdAt])
  @@index([replyToId])
  @@map("voice_messages")
}

// ==============================================================
// TABLE Hub: hub_voice_messages (v4.37 « MESSAGES VOCAUX DU HUB »)
// Annonces audio de l'hôte déclenchées côté invité :
//   kind 'welcome'       → 1er clic « Mode Invité » (1× / appareil,
//                          ré-armé si l'hôte régénère la voix ou > 14 j)
//   kind 'checkout_eve'  → veille du départ, 1er scan après 20 h (1×)
//   kind 'checkout_day'  → jour du départ dès 9 h, chaque ouverture
// lang : 'fr' | 'en' | 'es' | 'ar' — repli lecture : français.
// source : 'tts' (voix générée) | 'upload' (voix du propriétaire).
// audioData : MP3/WAV base64 EN BASE (pattern v4.32 « audio durable »
// — les fichiers disque sont perdus au redéploiement Docker).
// @@unique([propertyId, kind, lang]) : une voix par langue et type.
// ==============================================================
model HubVoiceMessage {
  id          String   @id @default(cuid())
  propertyId  String   @map("property_id")
  kind        String   // 'welcome' | 'checkout_eve' | 'checkout_day' | 'menage_note' (v4.43 : consigne vocale hôte → femme de ménage, lang 'fr')
  lang        String   // 'fr' | 'en' | 'es' | 'ar'
  source      String   @default("tts") @map("source") // 'tts' | 'upload'
  text        String?  // texte source (TTS) ou légende de l'enregistrement
  audioData   String   @map("audio_data")        // base64 MP3/WAV (durable)
  audioMime   String   @default("audio/mpeg") @map("audio_mime")
  durationSec Int      @default(0) @map("duration_sec")
  fileSizeKb  Int      @default(0) @map("file_size_kb")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, kind, lang])
  @@index([propertyId])
  @@map("hub_voice_messages")
}

// ==============================================================
// TABLE 37: bookings (ÉTAPE 12 V2 — planning multi-propriétés)
// Séjours d'un bien : base du taux d'occupation (portfolio),
// du planning ménage (rôle CLEANER) et des futures intégrations
// iCal / Airbnb. source : 'AIRBNB' | 'BOOKING' | 'MANUAL' | 'ICAL'
// status : 'CONFIRMED' | 'CHECKED_IN' | 'CHECKED_OUT' | 'CANCELLED'
// cleaningStatus : 'PENDING' | 'IN_PROGRESS' | 'DONE'
// ==============================================================
model Booking {
  id             String   @id @default(cuid())
  propertyId     String   @map("property_id")
  guestName      String   @map("guest_name")
  guestEmail     String?  @map("guest_email")
  // PREMIUM V5 — téléphone invité (E.164) pour le SMS « Bouclier
  // d'avis » envoyé le matin du départ (automation review_shield_departure).
  guestPhone     String?  @map("guest_phone")
  checkIn        DateTime @map("check_in")
  checkOut       DateTime @map("check_out")
  guests         Int      @default(2)
  source         String   @default("MANUAL")
  status         String   @default("CONFIRMED")
  cleaningStatus String   @default("PENDING") @map("cleaning_status")
  externalRef    String?  @map("external_ref")      // code de réservation plateforme
  notes          String?
  // =============================================================
  // PREMIUM « CONCIERGERIE 5 ÉTOILES » (V5) — ÉTAPE 3 (automations)
  // =============================================================
  // Bouclier d'avis : token unique → /app/hub/[slug]/guest/feedback?token=…
  // (généré paresseusement au tick REVIEW_SHIELD_TODAY — lien direct
  // vers le Review Shield pré-rempli, anti-spam, révocable).
  feedbackToken String?   @unique @map("feedback_token")
  // Late check-out : 'REQUESTED' (Checkout Session créée) | 'PAID'
  // (webhook checkout.session.completed) | null (aucune demande).
  lateCheckoutStatus String?   @map("late_checkout_status")
  lateCheckoutPaidAt DateTime? @map("late_checkout_paid_at")
  // v4.50 « VERROUILLAGE DU HUB PAR CODE » — code d'activation du hub
  // pour CE séjour (4 caractères). Généré automatiquement à la création
  // (4 derniers chiffres du téléphone → 4 derniers du code plateforme
  // → aléatoire unique), modifiable par l'hôte (PATCH bookings).
  accessCode     String?   @map("access_code")
  // Départ tardif VALIDÉ par l'hôte (prolongement du verrouillage) :
  // datetime exact du nouveau départ (ex. 12/10/2026 15:00). null =
  // fin de séjour = checkOut (ou +11 h UTC si checkOut à minuit UTC).
  lateCheckOutUntil DateTime? @map("late_checkout_until")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // v4.50 — sessions hub + minibar rattachés au séjour (supprimés avec).
  hubAccessSessions HubAccessSession[]
  minibarOrders     MinibarOrder[]
  minibarChecks     MinibarCheck[]
  minibarRestocks   MinibarRestockRequest[]
  // v4.52 — middle-stay care + souvenirs rattachés au séjour (supprimés avec).
  middleStayRequests MiddleStayRequest[]
  guestMemories      GuestMemory[]
  // v4.53 « PRÊT POUR L'ARRIVÉE » — notification anticipée envoyée au
  // voyageur dès que le ménage est validé avant son arrivée (Early
  // Check-in Alert). null = jamais envoyée (dédupe : 1 envoi / séjour).
  readyNotificationSentAt DateTime? @map("ready_notification_sent_at")
  // v4.53 « RAPPORT DE CHECK-OUT » — récapitulatifs auto du séjour.
  checkoutReports    CheckoutReport[]
  // v4.54 — commandes pressing + alertes stock rattachées au séjour.
  laundryOrders      LaundryOrder[]
  inventoryAlerts    InventoryAlert[]
  // v5.0 — états des lieux de sortie signés par l'invité (preuve publique).
  checkOutInspections CheckOutInspection[]
  // v4.95 — demandes particulières du séjour (lit bébé, siège bébé…).
  specialRequests     SpecialRequest[]
  // v4.96 — intervention de ménage de sortie planifiée pour ce séjour
  // (1 max / séjour, générée automatiquement à la confirmation).
  housekeepingTasks   HousekeepingTask[]

  @@index([propertyId, accessCode])

  @@index([propertyId])
  @@index([checkIn])
  @@index([checkOut])
  @@index([status])
  // AUDIT PRÉ-PROD — index composites du tick quotidien (arrivée/départ/J-3/J+1)
  @@index([propertyId, status, checkIn])
  @@index([propertyId, status, checkOut])
  @@map("bookings")
}

// ==============================================================
// TABLE 47: property_ical_feeds (HOST-5 — Calendrier, import iCal)
// Flux iCal externes (Airbnb / Booking.com / Abritel…) d'un bien.
// La synchronisation (POST /api/airbnb/ical/sync) télécharge le
// calendrier, parse les VEVENT et upsert les Bookings source
// 'ICAL' (externalRef = UID de l'événement, idempotent).
// lastStatus : 'OK' | 'ERROR' | null (jamais synchronisé)
// ==============================================================
model PropertyIcalFeed {
  id          String    @id @default(cuid())
  propertyId  String    @map("property_id")
  label       String                              // ex: "Airbnb — Loft"
  url         String                              // webcal:// converti en https://
  lastSyncAt  DateTime? @map("last_sync_at")
  lastStatus  String?   @map("last_status")       // 'OK' | 'ERROR'
  lastError   String?   @map("last_error")
  lastImported Int      @default(0) @map("last_imported") // nb bookings upserts au dernier sync
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_ical_feeds")
}

// ==============================================================
// TABLE 39: service_orders (ÉTAPE 17 V3 — Moteur de transaction)
// Commandes invités sur le catalogue des prestataires (upselling,
// Morning Box, expériences) passées depuis l'app invitée PWA.
//
// SÉPARATION FINANCIÈRE (règle métier V3) :
//   totalAmount  = ce que paie l'invité
//   commission   = part de Conciergerie Hub
//   hostEarning  = part de l'hôte (si marge appliquée)
//   invariant attendu côté application : totalAmount ≈ commission + hostEarning
//
// items : détails de la commande (ex: [{"name":"Morning Box M",
//         "qty":2,"unitPrice":18}]).
//
// status (OrderStatus) — SQLite : String documenté (cf. header) :
//   'PENDING' | 'CONFIRMED' | 'PREPARING' | 'DELIVERED' | 'CANCELLED'
//
// bookingId / propertyId : volontairement SANS contrainte FK → la
// trace financière survit à la suppression d'un séjour ou d'un bien
// (guestName/guestEmail dénormalisés dans le même but).
// ==============================================================
model ServiceOrder {
  id           String    @id @default(uuid())
  bookingId    String?   @map("booking_id")     // Lié à un séjour spécifique
  propertyId   String    @map("property_id")
  providerId   String    @map("provider_id")
  guestName    String    @map("guest_name")
  guestEmail   String?   @map("guest_email")
  items        Json                             // Détails de la commande (ex: 2x Box M)
  // REFONTE SERVICES PREMIUM (V4.11) — instructions de livraison
  // dictées par l'invité au checkout (allergies, étage, creneau…).
  guestNote    String?   @map("guest_note")
  totalAmount  Float     @map("total_amount")   // Montant total payé par l'invité
  commission   Float                            // La part de Conciergerie Hub
  hostEarning  Float     @map("host_earning")   // La part de l'hôte (si marge appliquée)
  status       String    @default("PENDING")    // OrderStatus : 'PENDING' | 'CONFIRMED' | 'PREPARING' | 'DELIVERED' | 'CANCELLED'
  deliveryDate DateTime? @map("delivery_date")
  createdAt    DateTime  @default(now()) @map("created_at")

  // ÉTAPE 17.6 — Paiement in-app (orthogonal au cycle de vie : une
  // commande peut être PENDING & payée d'avance, ou payée à la livraison)
  paymentStatus   String    @default("UNPAID")  // PaymentStatus : 'UNPAID' | 'PAID' | 'REFUNDED' | 'FAILED'
  stripeSessionId String?   @map("stripe_session_id") // Checkout Session (mode 'payment')
  stripePaymentId String?   @map("stripe_payment_id") // PaymentIntent confirmé (webhook)
  paidAt          DateTime? @map("paid_at")

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([propertyId])
  @@index([providerId])
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  @@map("service_orders")
}

// ==============================================================
// TABLE 32: service_offers (ÉTAPE 17.5 — catalogue fin par service)
// Offres commandables d'un prestataire GUEST_EXPERIENCE POUR UN
// BIEN donné. Le prix de l'offre est l'AUTORITÉ de facturation
// côté serveur (le prix envoyé par le client n'est jamais cru).
// unit : libellé libre ('prestation' | 'personne' | 'box' | …).
// Unique (propertyId, providerId, name) — pas de doublon d'affichage.
// ==============================================================
model ServiceOffer {
  id          String   @id @default(cuid())
  propertyId  String   @map("property_id")
  providerId  String   @map("provider_id")
  name        String
  description String?
  unitPrice   Float    @map("unit_price") // prix de facturation (autorité serveur)
  unit        String   @default("prestation")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  // REFONTE SERVICES (v4.23) — photo réelle de l'offre (URL distante ou
  // /uploads). Null → fallback gradient + emoji (service-visual.tsx).
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, providerId, name])
  @@index([propertyId])
  @@index([providerId])
  @@index([isActive])
  @@map("service_offers")
}

// ==============================================================
// TABLE 34: email_outbox (ÉTAPE 22 — emails transactionnels)
// Queue d'emails sortants. Toute notification métier (réservation,
// commande, remboursement, automatisation hôte…) y est journalisée :
//  - status 'QUEUED' → tenté, 'SENT' → remis au provider (ou mode
//    démo dev), 'FAILED' → échec retentable via la Console Superadmin
//  - provider : 'resend' | 'smtp' | 'demo' (dev sans clés — aucun
//    envoi réel, l'email reste consultable dans la console)
//  - jamais de clé étrangère dure : un email survit à la suppression
//    de l'entité liée (audit compta/support).
// ==============================================================
model EmailOutbox {
  id        String   @id @default(cuid())
  to        String
  subject   String
  htmlBody  String   @map("html_body")
  textBody  String?  @map("text_body")
  template  String   // clé de template : 'host_notification' | 'guest_receipt' | 'guest_refund' | 'custom'
  status    String   @default("QUEUED") // 'QUEUED' | 'SENT' | 'FAILED'

  // Pièce jointe optionnelle (v5.3 — certificats PDF Bouclier).
  attachmentData Bytes?  @map("attachment_data")
  attachmentName String? @map("attachment_name")
  attachmentMime String? @map("attachment_mime")
  provider  String?  // 'resend' | 'smtp' | 'demo'
  attempts  Int      @default(0)
  lastError String?  @map("last_error")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Traçabilité métier (optionnelle, sans relation)
  userId      String? @map("user_id")
  propertyId  String? @map("property_id")
  referenceType String? @map("reference_type") // 'booking' | 'service_order' | 'automation' | …
  referenceId   String? @map("reference_id")
  metaJson      String  @default("{}") @map("meta_json")

  @@index([status])
  @@index([template])
  @@index([createdAt])
  @@index([propertyId])
  @@index([referenceType, referenceId])
  @@map("email_outbox")
}

// ==============================================================
// TABLE 39bis: email_templates (FIX-12 — éditeur Superadmin)
// Modèles d'emails éditables depuis /admin/emails (onglet Modèles).
// Le rendu réel (lib/email-template-render.ts) lit D'ABORD la ligne
// active par `key`, avec fallback silencieux sur les templates codés
// en dur (lib/email-templates.ts) si absente ou isActive=false.
// Variables du corps : jetons {{nom}} substitués au rendu.
// ==============================================================
model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique              // ex: 'guest_welcome'
  subject     String
  htmlBody    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("email_templates")
}

// ==============================================================
// TABLE 40: audit_logs (Console Superadmin — Module 8 Logs)
// Journal d'audit des actions d'administration : chaque mutation
// faite depuis /admin/* est tracée (acteur, cible, détails, IP).
// ==============================================================
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?  @map("actor_id")       // user.id du Superadmin (null = système)
  actorEmail  String   @map("actor_email")    // copie lisible (survit à la suppression du compte)
  action      String                                  // 'user.deactivate' | 'user.plan_change' | 'batch.create' | …
  entityType  String   @map("entity_type")            // 'user' | 'provider' | 'subscription' | 'setting' | …
  entityId    String?  @map("entity_id")
  detailsJson String   @default("{}") @map("details_json")
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ==============================================================
// TABLE 41: platform_settings (Module 7 Paramètres)
// Key-value store de configuration plateforme. La valeur est une
// chaîne JSON validée côté lib/settings.ts (défauts typés).
// ==============================================================
model PlatformSetting {
  key       String   @id
  value     String                                 // JSON string
  updatedBy String?  @map("updated_by")            // email du Superadmin
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ==============================================================
// TABLE 42: feature_flags (Module 7 Paramètres)
// Interrupteurs fonctionnels réels, lus par les routes métier
// (ex: 'signups_enabled' dans /api/auth/register).
// ==============================================================
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// ==============================================================
// TABLE 43: api_keys (Module 7 Sécurité)
// Clés d'API pour consommateurs externes (dashboard partenaires).
// La clé en clair n'est JAMAIS stockée : hash SHA-256 + préfixe
// d'identification (8 premiers caractères).
// ==============================================================
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String                                  // 8 premiers caractères de la clé (identification)
  hashedKey  String    @unique @map("hashed_key")    // sha256 hex
  createdBy  String?   @map("created_by")            // email Superadmin
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([prefix])
  @@map("api_keys")
}

// ==============================================================
// TABLE 44: ip_blacklist (Module 7 Sécurité)
// IP bannies : vérifiées AVANT le rate limiting sur login,
// inscription et paiement de commande (lib/security.ts).
// ==============================================================
model IpBlacklist {
  ip        String   @id
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ip_blacklist")
}

// ==============================================================
// TABLE 45: support_tickets (Module 8 Logs — Tickets support)
// Tickets gérés par le Superadmin ; créables manuellement ou
// depuis un email transactionnel en échec (EmailOutbox FAILED).
// ==============================================================
model SupportTicket {
  id        String   @id @default(cuid())
  subject   String
  email     String
  priority  String   @default("NORMAL") // 'LOW' | 'NORMAL' | 'HIGH' | 'URGENT'
  status    String   @default("OPEN")   // 'OPEN' | 'PENDING' | 'RESOLVED' | 'CLOSED'
  body      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}

// ==============================================================
// TABLE 46: payouts (Module 6 Transactions — Reversements)
// Reversement des gains prestataires (ServiceOrder payées non
// encore reversées). Stripe Connect si compte Express actif,
// sinon marquage manuel (virement externe).
// ==============================================================
model Payout {
  id               String    @id @default(cuid())
  providerId       String    @map("provider_id")
  amount           Float
  currency         String    @default("EUR")
  status           String    @default("PENDING")     // 'PENDING' | 'PAID' | 'FAILED'
  method           String    @default("STRIPE_CONNECT") // 'STRIPE_CONNECT' | 'MANUAL'
  stripeTransferId String?   @map("stripe_transfer_id")
  ordersCount      Int       @default(0) @map("orders_count")
  note             String?
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("payouts")
}

// ==============================================================
// TABLE 48: private_feedbacks (PREMIUM V5 — ÉTAPE 3.4 — Alerte Guest)
// Retours privés 1-3 ★ collectés par le Bouclier d'avis (Review
// Shield). URGENCE hôte : alerte critique Email + Push immédiate.
// rating : 1..5 (le flux n'y écrit QUE des avis 1-3, mais 4-5 est
// toléré pour la traçabilité d'un retour privé spontané).
// token  : feedbackToken du booking utilisé (traçabilité du lien).
// isResolved : coché côté hôte une fois le problème traité.
// ==============================================================
model PrivateFeedback {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  bookingId  String?  @map("booking_id")
  rating     Int
  comment    String?
  guestName  String?  @map("guest_name")
  token      String?
  isResolved Boolean  @default(false) @map("is_resolved")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, isResolved])
  @@index([createdAt])
  @@map("private_feedbacks")
}

// ==============================================================
// TABLE 49: guest_sessions (PREMIUM V5 — ÉTAPE 3.5 — Premier scan)
// Session anonyme de l'invité dans le Hub (deviceId UUID généré côté
// client, stocké en localStorage). 1re ligne = premier scan du QR →
// notification « 👋 [Nom] vient d'arriver et a scanné votre Hub ! »
// à l'hôte. bookingId optionnel (si invité lié à un séjour ?b=).
// ==============================================================
model GuestSession {
  id          String   @id @default(cuid())
  propertyId  String   @map("property_id")
  deviceId    String   @map("device_id")
  bookingId   String?  @map("booking_id")
  guestName   String?  @map("guest_name")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, deviceId])
  @@index([propertyId])
  @@index([firstSeenAt])
  @@map("guest_sessions")
}

// ==============================================================
// TABLE 50: password_reset_tokens (AUDIT PRÉ-PROD — Reset password)
// Flux « mot de passe oublié » : token aléatoire 48 hex, stocké
// HASHÉ (SHA-256) — la valeur en clair n'existe QUE dans l'email.
// expiresAt : 1 h ; usedAt : single-use ; rate limit 3/h par IP.
// ==============================================================
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ==============================================================
// TABLE v4.50: hub_access_sessions (VERROUILLAGE DU HUB PAR CODE)
// Le hub d'un bien peut être PROTÉGÉ par un code d'activation unique
// par séjour (Booking.accessCode). Le voyageur scanne le QR → écran
// de verrouillage → saisit son code → le serveur crée une session :
//   • token 48 hex renvoyé au client (localStorage) ;
//   • SEUL le SHA-256 du token est stocké (jamais la valeur claire) ;
//   • la fin de session est VÉRIFIÉE EN DIRECT contre la fin de séjour
//     effective du booking (lateCheckOutUntil ?? checkOut) — une
//     prolongation validée par l'hôte rallonge automatiquement la
//     session au prochain appel (compte à rebours client aussi).
// Chaque action du hub (minibar, commandes, tickets, départ) envoie
// l'en-tête x-hub-token ; le serveur rejette en 403 SESSION_EXPIRED
// dès que l'heure actuelle dépasse la fin de séjour.
// ==============================================================
model HubAccessSession {
  id          String    @id @default(cuid())
  propertyId  String    @map("property_id")
  bookingId   String?   @map("booking_id")
  tokenHash   String    @unique @map("token_hash")
  // Plafond de sécurité absolu (fin de séjour + 7 jours) même si le
  // booking disparaît — la session meurt au plus tard ici.
  hardExpiresAt DateTime @map("hard_expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([bookingId])
  @@map("hub_access_sessions")
}

// ==============================================================
// TABLE v4.50: minibar_orders (MINIBAR DE CONFIANCE — commandes)
// Chaque déclaration du minibar est PERSISTÉE (v4.44 ne faisait que
// notifier) : l'onglet Check-in/Check-out du hub peut afficher les
// produits consommés, et « Facturer au départ » s'appuie sur ces
// lignes OPEN réglables à la sortie.
// itemsJson : [{ id, name, emoji, qty, unitPrice, lineTotal, free }]
// payment   : 'stripe' | 'onsite' | 'departure' | 'free'
// status    : 'OPEN' (à régler) | 'PAID' (réglé — Stripe ou sur place)
// ==============================================================
model MinibarOrder {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  bookingId  String?  @map("booking_id")
  guestName  String?  @map("guest_name")
  itemsJson  String   @map("items_json")
  totalEur   Float    @default(0) @map("total_eur")
  payment    String   @default("onsite")
  status     String   @default("OPEN")            // 'OPEN' | 'PAID'
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([bookingId])
  @@map("minibar_orders")
}

// ==============================================================
// TABLE v4.50: minibar_checks (VALIDATION D'INVENTAIRE À L'ARRIVÉE)
// Système de confiance : l'invité voit la photo du minibar rempli
// (configurée par l'hôte) + la liste des articles, et valide en
// UN CLIC « J'ai vérifié, tout est là ». La validation est horodatée
// et rattachée au séjour courant — protège l'hôte ET l'invité.
// ==============================================================
model MinibarCheck {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  bookingId  String?  @map("booking_id")
  guestName  String?  @map("guest_name")
  // v5.0 « ÉTAT DES LIEUX D'ENTRÉE » — token public de preuve (URL sans auth).
  publicToken String?  @unique @map("public_token")
  checkedAt  DateTime @default(now()) @map("checked_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId, checkedAt])
  @@index([bookingId])
  @@map("minibar_checks")
}

// ==============================================================
// TABLE v4.50: minibar_restock_requests (RECHARGER LE FRIGO — 1 CLIC)
// Si l'invité a consommé l'essentiel du minibar, un bouton lui permet
// de demander un réapprovisionnement automatique pour le lendemain
// matin lors du passage de l'équipe d'entretien. L'hôte voit la liste
// PENDING dans le dashboard et la marque « traitée ».
// status : 'PENDING' | 'DONE'
// ==============================================================
model MinibarRestockRequest {
  id         String    @id @default(cuid())
  propertyId String    @map("property_id")
  bookingId  String?   @map("booking_id")
  guestName  String?   @map("guest_name")
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now()) @map("created_at")
  handledAt  DateTime? @map("handled_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([bookingId])
  @@map("minibar_restock_requests")
}

// ==============================================================
// TABLE v4.52: middle_stay_requests (MIDDLE-STAY CARE)
// Séjours longs (≥ 7 nuits) : l'invité demande un RÉASSORT
// (serviettes, papier toilette…) ou un MÉNAGE EN COURS DE SÉJOUR
// depuis le Hub. L'hôte voit la file dans son espace et suit le
// statut : pending → in_progress → completed.
// price : Float (SQLite — Decimal non supporté) ; réserve pour un
// futur ménage payant facturé via Stripe.
// assignedTo : identifiant (email/id) du membre d'équipe assigné.
// ==============================================================
model MiddleStayRequest {
  id          String    @id @default(cuid())
  propertyId  String    @map("property_id")
  bookingId   String?   @map("booking_id")
  guestName   String    @map("guest_name")
  guestEmail  String?   @map("guest_email")
  requestType String    @map("request_type") // 'restock' | 'cleaning'
  details     String? // ex. « Besoin de 4 serviettes et papier toilette »
  status      String    @default("pending")  // pending | in_progress | completed
  assignedTo  String?   @map("assigned_to")
  price       Float? // ménage payant (si facturé)
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([bookingId])
  @@map("middle_stay_requests")
}

// ==============================================================
// TABLE v4.52: guest_memories (LIVRE D'OR VIVANT — mur de souvenirs)
// Chaque invité peut laisser un souvenir (note 1-5 + message + photos
// + vocal). MODÉRATION hôte : isApproved (validé) ET isPublic
// (autorisation du voyageur) → visible dans la galerie publique.
// isPinned : coup de cœur épinglé par l'hôte. hostReply : remerciement
// de l'hôte affiché sous le souvenir.
// photoUrlsJson : JSON string [{ url, caption? }] — SQLite n'accepte
// pas les listes scalaires ; dataURL ≤ ~400 Ko/photo, ≤ 5 photos.
// audioUrl : dataURL du vocal (≤ 60 s, même pipeline que les voix).
// ==============================================================
model GuestMemory {
  id            String    @id @default(cuid())
  propertyId    String    @map("property_id")
  bookingId     String?   @map("booking_id")
  guestName     String    @map("guest_name")
  guestEmail    String?   @map("guest_email")
  guestCountry  String?   @map("guest_country") // ex. "France" → drapeau côté UI
  rating        Int // 1 à 5
  message       String?
  photoUrlsJson String    @default("[]") @map("photo_urls_json")
  audioUrl      String?   @map("audio_url")
  isPublic      Boolean   @default(true) @map("is_public")
  isApproved    Boolean   @default(false) @map("is_approved")
  isPinned      Boolean   @default(false) @map("is_pinned")
  hostReply     String?   @map("host_reply")
  hostReplyAt   DateTime? @map("host_reply_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId, isApproved, isPublic])
  @@index([propertyId, isPinned])
  @@index([bookingId])
  @@map("guest_memories")
}

// =============================================================
// TABLE v4.53: checkout_reports (RAPPORT DE CONSOMMATION AUTO)
// Au moment où le compte à rebours du séjour expire (ou au départ
// confirmé), RoomScan génère un récapitulatif NET pour l'hôte :
//   « Consommations Minibar : 2 eaux, 1 vin — 12,50 €.
//     Signalements : Aucun. Preuve Ménage : Validée à 14h15. »
// Le rapport est COMPLÉTÉ à chaque événement (consommation, départ
// confirmé, validation du ménage de rotation) et consultable en un
// clic depuis le tableau de bord hôte (export PDF inclus).
// minibarJson      : JSON [{ name, emoji, qty, total, free }]
// signalementsJson : JSON [{ category, label, description, isUrgent,
//                            status, createdAt }] (hors miroirs ménage)
// minibarCheckedAt : inventaire d'arrivée validé par l'invité
// cleaningValidatedAt : preuve ménage POST-départ (rotation suivante)
// departedAt       : départ définitif confirmé (CheckoutFinalEvent)
// =============================================================
model CheckoutReport {
  id               String    @id @default(cuid())
  propertyId       String    @map("property_id")
  bookingId        String?   @map("booking_id")
  guestName        String?   @map("guest_name")
  checkIn          DateTime? @map("check_in")
  checkOut         DateTime? @map("check_out")
  minibarJson      String    @default("[]") @map("minibar_json")
  minibarTotal     Float     @default(0) @map("minibar_total")
  // Inventaire d'arrivée validé par l'invité (MinibarCheck) —
  // null = pas de validation (séjours antérieurs à v4.50).
  minibarCheckedAt DateTime? @map("minibar_checked_at")
  signalementsJson String    @default("[]") @map("signalements_json")
  signalementsCount Int      @default(0) @map("signalements_count")
  cleaningValidatedAt DateTime? @map("cleaning_validated_at")
  cleaningStaffName   String?   @map("cleaning_staff_name")
  departedAt       DateTime? @map("departed_at")
  restockPending   Boolean   @default(false) @map("restock_pending")
  generatedAt      DateTime  @default(now()) @map("generated_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([propertyId, bookingId])
  @@index([propertyId, generatedAt])
  @@map("checkout_reports")
}

// ==============================================================
// TABLE v4.54: laundry_orders (PRESSING & BLANCHISSERIE EXPRESS)
// Nouvel onglet du Hub Invité : l'invité choisit un service
// (repassage express, lessive complète, pressing à sec), estime
// ses pièces, choisit un créneau de récupération (matin/après-midi)
// et paie par Stripe (cloné du late check-out) ou laisse une simple
// demande à l'hôte. L'hôte suit les commandes et leur statut.
// ==============================================================
model LaundryOrder {
  id          String   @id @default(cuid())
  propertyId  String   @map("property_id")
  bookingId   String?  @map("booking_id")
  guestName   String?  @map("guest_name")
  guestEmail  String?  @map("guest_email")
  // 'ironing' (repassage 5 €/pièce) | 'washing' (lessive 15 €/panier)
  // | 'drycleaning' (pressing à sec 8 €/pièce) — tarifs SERVEUR.
  serviceType String   @map("service_type")
  pieces      Int      @default(1)
  // Créneau de récupération souhaité : 'morning' | 'afternoon'.
  pickupSlot  String   @default("morning") @map("pickup_slot")
  notes       String?
  amountEur   Float    @default(0) @map("amount_eur")
  // 'stripe' (Checkout Session) | 'host' (règlement avec l'hôte).
  payment     String   @default("host")
  // PENDING_PAYMENT → REQUESTED → PAID → IN_PROGRESS → READY → DELIVERED
  // | CANCELLED. L'autorité d'affichage invité = status.
  status      String   @default("REQUESTED")
  stripeSessionId String? @map("stripe_session_id")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([propertyId, createdAt])
  @@index([bookingId])
  @@map("laundry_orders")
}

// ==============================================================
// TABLE v4.54: inventory_alerts (ALERTES STOCK — équipe de ménage)
// L'équipe scanne le QR « Ménage » et signale en 3 clics l'état du
// stock (✅ OK / ⚠️ Stock bas / ❌ Épuisé) sur 4 postes : serviettes,
// papier toilette, savon/shampooing, capsules café. Tout signalement
// non-OK déclenche une alerte automatique à l'hôte (cloche + email).
// ==============================================================
model InventoryAlert {
  id          String   @id @default(cuid())
  propertyId  String   @map("property_id")
  bookingId   String?  @map("booking_id")
  // "serviettes" | "papier_toilette" | "savon_shampooing" | "capsules_cafe"
  item        String
  // "ok" | "low" | "empty"
  status      String
  // Nom du membre d'équipe qui a signalé (saisie libre).
  reportedBy  String?  @map("reported_by")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([propertyId, createdAt])
  @@map("inventory_alerts")
}

// ==============================================================
// TABLE v4.56: system_settings (CONFIG PLATEFORME — clé/valeur)
// Réglages globaux éditables depuis la Console Superadmin
// (ex : email.from, email.notifications_inbox).
// Priorité de résolution : base de données > variable
// d'environnement > défaut codé. Valeur vide = pas d'override.
// ==============================================================
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ==============================================================
// TABLE v5.0: check_out_inspections (ÉTAT DES LIEUX DE SORTIE)
// L'invité constate l'état dans lequel il rend le logement avant de
// partir : statut par pièce (good|dirty|damaged), photos des dégâts
// (dataURL compressés côté client, convention ≤ 500 KB), inventaire
// rendu, auto-évaluation, signature digitale. Un PDF horodaté est
// généré à la demande (pdfkit, server-side) et une URL publique
// unique (/public/inspection/[publicToken]) sert de preuve légale
// consultable sans authentification. Email envoyé à l'hôte + l'invité.
// status : 'pending' | 'reviewed' | 'resolved' | 'disputed'
// ==============================================================
model CheckOutInspection {
  id               String   @id @default(cuid())
  propertyId       String   @map("property_id")
  bookingId        String?  @map("booking_id")
  guestName        String   @map("guest_name")
  guestEmail       String?  @map("guest_email")

  // v4.80 — TYPE d'état des lieux : 'checkin' (entrée — validé après
  // déverrouillage du hub, pièces + photos + signature) ou 'checkout'
  // (sortie — inclut aussi l'inventaire du minibar). Le défaut
  // 'checkout' garantit la rétrocompatibilité des enregistrements v5.0.
  type             String   @default("checkout")

  // Statut par pièce : 'good' | 'dirty' | 'damaged'
  entranceStatus    String  @default("good") @map("entrance_status")
  kitchenStatus     String  @default("good") @map("kitchen_status")
  livingRoomStatus  String  @default("good") @map("living_room_status")
  bedroomsStatus    String  @default("good") @map("bedrooms_status")
  bathroomStatus    String  @default("good") @map("bathroom_status")

  // Détails : issues = commentaires libres, damages = résumé des dégâts.
  issues          String?
  damages         String?
  // Photos des problèmes (JSON array de dataURL images compressées).
  damagePhotos    Json?    @map("damage_photos")
  // Détail complet des pièces (JSON array [{id,label,status,comment,photos[]}]).
  roomsData       Json?    @map("rooms_data")
  // Inventaire rendu (JSON {keys,remotes,towels,…}).
  inventoryCheck  Json?    @map("inventory_check")
  // v4.80 « MINIBAR À LA SORTIE » — inventaire du minibar déclaré par
  // l'invité : JSON [{ name, consumed }] (unités consommées par article).
  minibarData     Json?    @map("minibar_data")

  // Auto-évaluation de l'invité (1-5 étoiles).
  selfAssessment  Int      @default(5) @map("self_assessment")

  // Signature digitale (dataURL PNG) + traçabilité légale.
  guestSignature  String?  @map("guest_signature")
  signedAt        DateTime @default(now()) @map("signed_at")
  ipAddress       String?  @map("ip_address")

  // Preuve publique : /public/inspection/[publicToken] (sans auth).
  publicToken     String   @unique @map("public_token")

  // Résolution côté hôte.
  status          String   @default("pending")
  hostNotes       String?  @map("host_notes")
  resolvedAt      DateTime? @map("resolved_at")

  createdAt       DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([bookingId])
  @@index([status])
  @@map("check_out_inspections")
}

// ==============================================================
// TABLE v4.69: host_settings (COMMISSION & PAIEMENT HÔTE)
// Configuration économique par hôte : il encaisse les paiements via
// son propre Stripe (useOwnStripe + clés) ou passe par la plateforme.
// RoomScan prélève une commission (ex 0.10 ou 0.20) facturée en fin
// de mois (MonthlyCommissionInvoice).
// NB : SQLite ne supporte pas le type Decimal Prisma → montants Float
// (convention déjà utilisée par Subscription.amount / Transaction).
// ==============================================================
model HostSettings {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Configuration paiement
  useOwnStripe    Boolean  @default(false) @map("use_own_stripe") // Si true, l'hôte utilise ses propres clés
  stripePubKey    String?  @map("stripe_pub_key")
  stripeSecretKey String?  @map("stripe_secret_key")

  // Configuration commission (ex: 0.20 pour 20 %)
  commissionRate  Float    @default(0.20) @map("commission_rate")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("host_settings")
}

// ==============================================================
// TABLE v4.69: monthly_commission_invoices (FACTURES DE COMMISSION)
// Une facture par hôte et par mois : montant total des commandes
// encaissées par l'hôte (minibar + services + pressing) × taux de
// commission = commission due à RoomScan.
// status : 'pending' | 'paid' | 'overdue'
// ==============================================================
model MonthlyCommissionInvoice {
  id                String    @id @default(cuid())
  hostId            String    @map("host_id")
  host              User      @relation(fields: [hostId], references: [id], onDelete: Cascade)

  month             Int       // ex: 10 (Octobre)
  year              Int       // ex: 2026

  totalOrdersAmount Float     @map("total_orders_amount") // Montant total des commandes encaissées par l'hôte
  commissionRate    Float     @map("commission_rate")     // Taux appliqué (ex: 0.20)
  commissionOwed    Float     @map("commission_owed")     // Montant dû à RoomScan (totalOrdersAmount × commissionRate)

  ordersCount       Int       @default(0) @map("orders_count") // Détail : nombre de commandes facturées
  breakdown         Json?     // Détail { minibar: X, services: Y, laundry: Z } (Floats)

  status            String    @default("pending") // 'pending' | 'paid' | 'overdue'

  invoicePdfUrl     String?   @map("invoice_pdf_url") // Lien vers le PDF généré (facultatif)
  // v4.81 (AUDIT QA) — jeton public aléatoire pour accéder au PDF de la
  // facture sans authentification (même pattern que CheckOutInspection).
  pdfToken          String?   @unique @map("pdf_token")
  dueDate           DateTime  @map("due_date")        // ex: 30 du mois suivant
  paidAt            DateTime? @map("paid_at")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([hostId, month, year])
  @@index([hostId])
  @@index([status])
  @@map("monthly_commission_invoices")
}

// ==============================================================
// TABLE v4.69: host_providers (MES PRESTATAIRES — annuaire privé)
// Prestataire ajouté manuellement par l'hôte pour un bien précis
// (ex: son plombier habituel, sa baby-sitter). Hors annuaire
// plateforme : visible uniquement sur CE bien, dans les onglets
// Prestataires (dashboard) et services invités (hub/PWA).
// audience : 'OWNER_SERVICE' | 'GUEST_EXPERIENCE'
// ==============================================================
model HostProvider {
  id            String   @id @default(cuid())
  propertyId    String   @map("property_id")
  name          String
  emoji         String   @default("🔧") // pastille catégorie (emoji libre)
  category      String   @default("Autre")
  description   String?
  contactName   String?  @map("contact_name")
  contactEmail  String?  @map("contact_email")
  contactPhone  String?  @map("contact_phone")
  website       String?
  audience      String   @default("OWNER_SERVICE") // 'OWNER_SERVICE' | 'GUEST_EXPERIENCE'
  isUrgentAvailable Boolean @default(false) @map("is_urgent_available")
  isActive      Boolean  @default(true) @map("is_active") // désactivable comme un prestataire annuaire
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([audience])
  @@map("host_providers")
}

// =============================================================
// v4.74 « SMART PROMPTS » — NOTIFICATIONS VISUELLES TEMPORELLES
// Système de notifications intelligentes affichées au bon moment
// (repas, veille de départ) pour inciter l'invité à commander.
// Configurables par le propriétaire du bien, journalisées pour
// éviter les doublons. SQLite : pas d'enum → String documentées.
// =============================================================

// Configuration des notifications par propriété (1:1).
model NotificationSettings {
  id         String   @id @default(cuid())
  propertyId String   @unique @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // ── Notifications temporelles (repas) ──
  enableBreakfast  Boolean @default(true) @map("enable_breakfast")
  breakfastTime    String  @default("08:00") @map("breakfast_time") // HH:mm
  breakfastMessage String  @default("☀️ Bonjour ! Souhaitez-vous commander votre petit-déjeuner ce matin ?") @map("breakfast_message")

  enableLunch      Boolean @default(true) @map("enable_lunch")
  lunchTime        String  @default("12:00") @map("lunch_time")
  lunchMessage     String  @default("🍽️ C'est l'heure du déjeuner ! Découvrez nos suggestions.") @map("lunch_message")

  enableDinner     Boolean @default(true) @map("enable_dinner")
  dinnerTime       String  @default("19:00") @map("dinner_time")
  dinnerMessage    String  @default("🌙 Bonne soirée ! Envie d'un dîner ou d'une réservation au restaurant ?") @map("dinner_message")

  // ── Notification veille de départ (boutique de souvenirs) ──
  enableCheckoutReminder  Boolean @default(true) @map("enable_checkout_reminder")
  checkoutReminderTime    String  @default("18:00") @map("checkout_reminder_time") // la veille du départ
  checkoutReminderMessage String  @default("🛍️ Demain est votre dernier jour ! Découvrez notre boutique de souvenirs.") @map("checkout_reminder_message")

  // Durée d'affichage de la carte (minutes) — 10 à 60 côté UI.
  displayDuration Int @default(30) @map("display_duration")

  // Inclure les recommandations de restaurants à proximité.
  enableRestaurantRecommendations Boolean @default(true) @map("enable_restaurant_recommendations")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_settings")
}

// Historique des notifications affichées (anti-doublon + analytics).
model NotificationLog {
  id               String   @id @default(cuid())
  propertyId       String   @map("property_id")
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookingId        String?  @map("booking_id")
  // 'breakfast' | 'lunch' | 'dinner' | 'checkout_reminder'
  notificationType String  @map("notification_type")
  displayedAt      DateTime @default(now()) @map("displayed_at")
  // Identifiant de session invité si disponible (anti-doublon fin).
  guestId          String? @map("guest_id")

  @@index([propertyId, notificationType])
  @@index([propertyId, displayedAt])
  @@map("notification_logs")
}

// =============================================================
// v4.74 « BOUTIQUE DE SOUVENIRS » — produits gérés par l'hôte,
// proposés à l'invité (notification veille de départ + module hub).
// =============================================================
model SouvenirProduct {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Float   // en euros (convention Float du schéma)
  imageUrl    String? @map("image_url")
  // 'food' | 'craft' | 'wine' | 'other'
  category    String  @default("food")
  isActive    Boolean @default(true) @map("is_active")
  sort        Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([propertyId, isActive])
  @@map("souvenir_products")
}

// Commande de souvenirs passée depuis le hub invité.
model SouvenirOrder {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookingId  String?  @map("booking_id")
  productId  String   @map("product_id")
  productName String  @map("product_name") // snapshot (le produit peut changer)
  quantity   Int      @default(1)
  unitPrice  Float    @map("unit_price") // snapshot du prix au moment de la commande
  // 'in_lodging' (livré au logement) | 'at_checkout' (à récupérer au départ)
  deliveryMode String @default("in_lodging") @map("delivery_mode")
  guestNote  String?  @map("guest_note")
  guestName  String?  @map("guest_name")
  // 'PENDING' | 'CONFIRMED' | 'DELIVERED' | 'CANCELLED'
  status     String   @default("PENDING")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([propertyId, status])
  @@index([propertyId, createdAt])
  @@map("souvenir_orders")
}

// ==============================================================
// TABLE v5.4: dashboard_insights (COACH ROOMSCAN — moteur d'analyse)
// Chaque insight est un conseil ACTIONNABLE généré par le moteur
// (src/lib/insight-engine.ts) à partir des données réelles du bien :
// stocks, séjours, avis, commandes, ménage, comportement invité.
// type     : 'STOCK' | 'REVENUE' | 'REVIEW' | 'UPSELL' | 'OPERATION'
//            | 'QUALITY' | 'BEHAVIOR'
// priority : 'CRITICAL' | 'HIGH' | 'MEDIUM' | 'LOW'
// score    : 0-100 (calculé par calculatePriority — ordre d'affichage)
// actionUrl: chemin RELATIF de la page d'action (deep-link cloche/push).
// expiresAt: les insights sensibles au temps expirent (opportunités) ;
//            null = visible jusqu'à résolution.
// ==============================================================
model DashboardInsight {
  id          String    @id @default(uuid())
  propertyId  String    @map("property_id")
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type        String
  priority    String
  score       Int

  title       String
  message     String // SQLite : TEXT illimité (pas de @db.Text)
  actionLabel String
  actionUrl   String

  isResolved  Boolean   @default(false) @map("is_resolved")
  resolvedAt  DateTime? @map("resolved_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  actions     InsightAction[]

  @@index([propertyId, isResolved, createdAt])
  @@map("dashboard_insights")
}

// ==============================================================
// TABLE v5.4: coach_preferences (préférences de l'hôte pour le coach)
// Relation 1:1 avec User. Contrôle les canaux de notification des
// insights critiques et la fréquence du rapport quotidien.
// enabledInsightTypes : JSON string array (SQLite n'accepte pas les
// listes scalaires) — ['STOCK','REVENUE','REVIEW','UPSELL',
// 'OPERATION','QUALITY','BEHAVIOR'].
// ==============================================================
model CoachPreferences {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Canaux de notification — urgences critiques ──
  enableCriticalPush     Boolean  @default(true) @map("enable_critical_push")
  enableCriticalEmail    Boolean  @default(true) @map("enable_critical_email")
  enableCriticalSMS      Boolean  @default(false) @map("enable_critical_sms") // optionnel (futur)

  // ── Canaux — opportunités de revenus ──
  enableRevenueEmail     Boolean  @default(true) @map("enable_revenue_email")
  enableRevenuePush      Boolean  @default(false) @map("enable_revenue_push")

  // ── Canaux — analyse qualité ──
  enableQualityEmail     Boolean  @default(true) @map("enable_quality_email")
  enableQualityDashboard Boolean  @default(true) @map("enable_quality_dashboard")

  // ── Conseils éducatifs dans le dashboard ──
  enableEducational      Boolean  @default(true) @map("enable_educational")

  // ── Fréquence du rapport quotidien ──
  // 'daily' | 'weekly' | 'never'
  reportFrequency        String   @default("daily") @map("report_frequency")
  reportTime             String   @default("07:00") @map("report_time") // HH:mm

  // ── Types d'insights affichés (JSON array de strings) ──
  enabledInsightTypes    String   @default("[\"STOCK\",\"REVENUE\",\"REVIEW\",\"UPSELL\",\"OPERATION\",\"QUALITY\",\"BEHAVIOR\"]") @map("enabled_insight_types")

  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("coach_preferences")
}

// ==============================================================
// TABLE v5.4: insight_actions (historique des actions sur un insight)
// actionType : 'RESOLVED' | 'DISMISSED' | 'SNOOZED' | 'CLICKED'
// Alimente le taux d'adoption du coach (CoachAnalytics).
// ==============================================================
model InsightAction {
  id         String           @id @default(uuid())
  insightId  String           @map("insight_id")
  insight    DashboardInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  userId     String           @map("user_id")
  actionType String           @map("action_type")

  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([insightId])
  @@index([userId])
  @@map("insight_actions")
}

// ==============================================================
// TABLE v5.4: coach_analytics (impact du coach — agrégé par mois)
// @@unique([propertyId, month, year]) — 1 ligne / bien / mois.
// estimatedRevenue : Float (SQLite — Decimal non supporté, convention
// du schéma). adoptionRate : % d'insights suivis (0-1).
// ==============================================================
model CoachAnalytics {
  id                String   @id @default(uuid())
  propertyId        String   @map("property_id")
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  month             Int
  year              Int

  insightsGenerated Int     @default(0) @map("insights_generated")
  insightsResolved  Int     @default(0) @map("insights_resolved")
  insightsDismissed Int     @default(0) @map("insights_dismissed")

  estimatedRevenue  Float   @default(0) @map("estimated_revenue")
  disputesAvoided   Int     @default(0) @map("disputes_avoided")

  adoptionRate      Float   @default(0) @map("adoption_rate")

  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([propertyId, month, year])
  @@index([propertyId])
  @@map("coach_analytics")
}

// ==============================================================
// TABLES v5.6 : « TOUR DE CONTRÔLE » — MONITORING 100 % MAISON
// (santé technique + métier, incidents, logs de cron)
// ==============================================================

// Métriques système — 1 ligne par tick (cron externe toutes les
// 5 min → /api/admin/monitoring-tick). SQLite : Float partout,
// externalChecks en JSON string (Stripe / Resend / disque).
// ==============================================================
model SystemMetric {
  id               String   @id @default(uuid())
  timestamp        DateTime @default(now())

  // Santé technique
  apiResponseTime  Float    // ms — durée du GET /api/health (self-fetch ou interne)
  dbResponseTime   Float    // ms — ping SELECT 1
  diskUsagePercent Float?   @map("disk_usage_percent") // % disque (si mesurable)

  // Santé technique externe (JSON string SQLite) :
  // { stripe: { status, latencyMs }, resend: { status, latencyMs } }
  externalChecks   String   @default("{}") @map("external_checks")
  status           String   @default("OK") // 'OK' | 'DEGRADED' | 'DOWN'

  // Santé métier (fenêtre glissante du tick : 5 min / 1 h)
  error500Count    Int      @default(0) @map("error_500_count") // AuditLog runtime.error 5 min
  failedPayments   Int      @default(0) @map("failed_payments") // Stripe échecs 1 h
  failedEmails     Int      @default(0) @map("failed_emails")   // outbox FAILED 1 h

  @@index([timestamp])
  @@map("system_metrics")
}

// Historique des incidents & alertes (détection + prédictif).
// Déduplication : un tick sur anomalie existante incrémente
// `occurrences` + met à jour `lastSeenAt` au lieu de recréer.
// ==============================================================
model SystemIncident {
  id             String    @id @default(uuid())
  severity       String    // 'INFO' | 'WARNING' | 'CRITICAL'
  category       String    // 'SERVER' | 'DATABASE' | 'PAYMENT' | 'EMAIL' | 'PREDICTIVE'

  title          String
  description    String

  isResolved     Boolean   @default(false) @map("is_resolved")
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")

  occurrences    Int       @default(1)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")

  // v4.98 — Dernier email d'alerte envoyé pour CET incident.
  // Alimente l'ESCALADE : un incident non résolu reçoit un rappel
  // email toutes les 4 h tant qu'il reste actif (le premier email
  // peut être raté : SMTP en échec, boîte saturée…).
  lastEmailAt    DateTime? @map("last_email_at")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([isResolved, createdAt])
  @@index([category, severity])
  @@map("system_incidents")
}

// Logs d'exécution des cron jobs (succès / échec / durée).
// Alimenté par les routes /api/admin/*-tick & co via logCronRun().
// ==============================================================
model SpecialRequest {
  id         String    @id @default(cuid())
  propertyId String    @map("property_id")
  bookingId  String?   @map("booking_id")
  guestName  String?   @map("guest_name")
  // Type de demande : 'extra_bed' | 'baby_crib' | 'baby_seat' | 'high_chair'
  // | 'towels' | 'iron' | 'cleaning' | 'other' (extensible).
  itemType   String    @map("item_type")
  quantity   Int       @default(1)
  note       String?
  // 'pending' | 'in_progress' | 'done' | 'cancelled'
  status     String    @default("pending")
  source     String    @default("hub")
  requestedAt DateTime @default(now()) @map("requested_at")
  handledAt  DateTime? @map("handled_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([bookingId])
  @@index([status])
  @@map("special_requests")
}

model CronLog {
  id           String   @id @default(uuid())
  jobName      String   @map("job_name") // 'monitoring-tick' | 'daily-automations' | 'coach-reports' | …
  status       String   // 'SUCCESS' | 'FAILED' | 'TIMEOUT'
  duration     Int      // ms
  errorMessage String?  @map("error_message")
  executedAt   DateTime @default(now()) @map("executed_at")

  @@index([jobName, executedAt])
  @@index([executedAt])
  @@map("cron_logs")
}

// ==============================================================
// ==============================================================
// MODULE STANDALONE « ÉTAT DES LIEUX » (v4.97)
// ------------------------------------------------------------
// Produit vendu 99 €/an, TOTALEMENT INDÉPENDANT du Hub :
// le propriétaire (User + InspectionSubscription) crée des
// inspections d'ENTRÉE / SORTIE, l'invité remplit le formulaire
// public via le token (roomscan.pro/i/<publicToken>), signe, et
// un PDF juridique (logo RoomScan + QR code) est généré à la
// volée. Une entrée peut être liée à sa sortie (InspectionLink).
// ==============================================================
// ==============================================================

// Abonnement au module EDL (limite « illimitée » du plan payant).
model InspectionSubscription {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  status    String   @default("active") // 'active' | 'cancelled'
  plan      String   @default("edl_annual") // 299 €/an — générations PDF illimitées
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspections Inspection[]
  shieldProperties ShieldProperty[]

  @@index([userId])
  @@map("inspection_subscriptions")
}

// ============================================================== 
// MODULE EDL STANDALONE — ACHAT PAYPAL 299 €/AN (v4.107)
// 1 ligne par tentative d'achat : created (commande PayPal créée)
// → paid (capture OK au retour) → activated (compte créé via le
// jeton). L'activationToken (72 h) est le SEUL sésame pour créer
// le compte post-paiement (lien unique envoyé au payeur).
// ==============================================================
model EdlPurchase {
  id                  String    @id @default(cuid())
  orderRef            String    @unique // référence interne (custom_id PayPal)
  paypalOrderId       String?   @unique // id commande PayPal après création
  amountEur           Int       @default(299)
  status              String    @default("created") // created | paid | activated | cancelled
  payerEmail          String?   @map("payer_email")
  activationToken     String    @unique @map("activation_token")
  activationExpiresAt DateTime  @map("activation_expires_at")
  userId              String?   @map("user_id") // compte créé à l'activation
  paidAt              DateTime? @map("paid_at")
  activatedAt         DateTime? @map("activated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("edl_purchases")
}

// État des lieux principal (ENTRÉE ou SORTIE).
model Inspection {
  id             String @id @default(cuid())
  subscriptionId String @map("subscription_id")

  // Logement & propriétaire
  propertyName    String @map("property_name")
  propertyAddress String @map("property_address")
  ownerName       String @map("owner_name")

  // Invité
  guestName  String  @map("guest_name")
  guestEmail String? @map("guest_email")
  guestPhone String? @map("guest_phone")

  // Type & date visée
  type          String // 'ENTREE' | 'SORTIE'
  scheduledDate DateTime @map("scheduled_date")

  // Statut & document public
  status      String @default("PENDING") // 'PENDING' | 'IN_PROGRESS' | 'COMPLETED'
  publicToken String @unique @map("public_token")
  pdfUrl      String? @map("pdf_url") // null = PDF généré à la volée

  // Section MÉNAGE intégrée (photo obligatoire si A_NETTOYER / TRES_SALE)
  cleanlinessScore    String? @map("cleanliness_score") // 'IMPECCABLE' | 'CORRECT' | 'A_NETTOYER' | 'TRES_SALE'
  cleanlinessComment  String? @map("cleanliness_comment")
  cleanlinessPhotoUrl String? @map("cleanliness_photo_url")

  // Signature électronique de l'invité (dataURL PNG)
  guestSignature String?   @map("guest_signature")
  signedAt       DateTime? @map("signed_at")

  // Preuve & anti-fraude (v4.110) — « Fait à [Ville] » saisi à la
  // création ; IP + GPS capturés à la signature ; SHA-256 du contenu
  // canonique du document (vérification d'intégrité, affiché dans
  // le PDF sous le QR code).
  city        String? @map("city")
  ipAddress   String? @map("ip_address")
  gpsLocation String? @map("gps_location") // ex. "14.7167° N, 17.4677° W"
  sha256Hash  String? @map("sha256_hash")

  // Liaison entrée <-> sortie (l'EDL de sortie peut référencer l'entrée)
  linkedInspectionId String?      @map("linked_inspection_id")
  linkedInspection   Inspection?  @relation("InspectionLink", fields: [linkedInspectionId], references: [id], onDelete: SetNull)
  linkedBy           Inspection[] @relation("InspectionLink")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  subscription InspectionSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  rooms        InspectionRoom[]

  @@index([subscriptionId, status])
  @@index([subscriptionId, createdAt])
  @@map("inspections")
}

// Pièce de l'état des lieux (Cuisine, Séjour, Chambre 1, Salle de bain…).
model InspectionRoom {
  id           String @id @default(cuid())
  inspectionId String @map("inspection_id")
  name         String
  globalState  String @default("BON") @map("global_state") // 'TRES_BON' | 'BON' | 'MOYEN' | 'MAUVAIS'
  comment      String?
  sortOrder    Int    @default(0) @map("sort_order")

  inspection Inspection     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  items      InspectionItem[]

  @@index([inspectionId])
  @@map("inspection_rooms")
}

// Élément / équipement d'une pièce (plaque de cuisson, télévision, lits…).
// RÈGLE D'OR : state = 'MAUVAIS' → comment + photoUrl OBLIGATOIRES
// (validés serveur dans /api/inspection/[token]/submit).
model InspectionItem {
  id        String  @id @default(cuid())
  roomId    String  @map("room_id")
  name      String
  state     String  @default("BON") // 'TRES_BON' | 'BON' | 'MOYEN' | 'MAUVAIS'
  comment   String?
  photoUrl  String? @map("photo_url") // dataURL compressée ≤ ~500 Ko
  // Appareils électroniques / électroménagers : preuve de
  // fonctionnement (optionnelle) — photo appareil ALLUMÉ / ÉTEINT.
  photoOnUrl  String? @map("photo_on_url")
  photoOffUrl String? @map("photo_off_url")
  sortOrder   Int     @default(0) @map("sort_order")

  room InspectionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("inspection_items")
}

// ==============================================================
// ROOMSCAN BOUCLIER AUTOMATISÉ (v5.1) — refonte du système
// d'état des lieux & sortie selon le template client :
//
//   1. ONBOARDING UNE FOIS (hôte, 10 min à vie) : photo initiale
//      des 6 zones + enregistrement des 4 appareils permanents →
//      génération de la BIBLIOTHÈQUE DE RÉFÉRENCE (verrouillée).
//   2. BIBLIOTHÈQUE RÉUTILISABLE : chaque appareil photographié
//      UNE SEULE FOIS (QR: REF-PLQ-12126 + hash SHA-256) — la
//      photo de référence est réutilisée à chaque check-in ; la
//      re-validation du jour est prouvée par la vidéo 30 s.
//   3. CHECK-IN / CHECK-OUT (agent, 90 s) : 6 PHOTOS FIXES aux
//      mêmes angles (fantôme de l'angle de référence superposé)
//      + VIDÉO WALKTHROUGH 30 s (QR géant + hash SHA-256).
//      Le PDF de sortie est COMPARATIF (entrée vs sortie).
//
// Références : ONB-{VIL}-{AAAA}-{nnn} (onboarding),
// REF-{KIND}-{DDMMYY} (appareil), CHK-{VIL}-{JJMMAAAA}-{nnn}
// (session). Statuts zone : IMPECCABLE | A_NETTOYER | DEGRADATION.
// ==============================================================

// Logement onboardé UNE FOIS (bibliothèque de référence).
model ShieldProperty {
  id              String   @id @default(cuid())
  subscriptionId  String   @map("subscription_id")
  propertyName    String   @map("property_name")
  propertyAddress String   @map("property_address")
  city            String   @default("DAKAR")
  ownerName       String   @map("owner_name")
  onboardingRef   String   @unique @map("onboarding_ref") // ONB-DAK-2026-001
  onboardedAt     DateTime @default(now()) @map("onboarded_at")
  // ── CONFIG DYNAMIQUE (wizard post-paiement, règle d'or « zéro N/A ») ──
  // SQLite ne supporte pas les listes Prisma natives → les listes sont
  // stockées en JSON stringifié (ex: '["SALON","COULOIR","CHAMBRE 1"]').
  nbChambres        Int    @default(0) @map("nb_chambres") // 0 = Studio, 3 = "3 chambres+"
  pieces            String @default("[]") @map("pieces") // JSON: pièces réelles du logement
  equipementsCoches String @default("[]") @map("equipements_coches") // JSON: kinds d'équipements présents
  nbPhotosMenage    Int    @default(4) @map("nb_photos_menage") // nb de photos par check-in = nb de zones
  // ── TASK 39 (v4.154) — DÉLÉGATION ONBOARDING ──
  // Le wizard demande « Avez-vous les photos de référence avec vous ? ».
  // NON → configuration textuelle seule, bien en PENDING_PHOTOS, et un
  // lien magique /upload/[delegationToken] (7 jours) permet à l'équipe
  // sur place de photographier zones + appareils. Réception → COMPLETED
  // (bibliothèque verrouillée + PDF ONB disponible + email au propriétaire).
  onboardingStatus         String    @default("COMPLETED") @map("onboarding_status") // 'COMPLETED' | 'PENDING_PHOTOS'
  delegationToken          String?   @unique @map("delegation_token") // token du lien magique (24-32 car. url-safe)
  delegationTokenExpiresAt DateTime? @map("delegation_token_expires_at") // +7 jours (lien expiré = écran dédié)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subscription InspectionSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  zones        ShieldZone[]
  devices      ShieldDevice[]
  sessions     ShieldSession[]

  @@index([subscriptionId])
  @@map("shield_properties")
}

// Zone fixe (SALON, COULOIR, CHAMBRE 1, CHAMBRE 2, CUISINE,
// TOILETTE / SDB) — la photo de référence sert de FANTÔME
// d'angle à chaque capture check-in / check-out.
model ShieldZone {
  id             String @id @default(cuid())
  propertyId     String @map("property_id")
  name           String
  referencePhoto String @map("reference_photo") // dataURL JPEG compressée ('' = en attente de délégation TASK 39)
  referenceHash  String? @map("reference_hash") // SHA-256 hex de la photo de référence (rempli à la réception délégation)
  sortOrder      Int    @default(0) @map("sort_order")

  property ShieldProperty   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  shots    ShieldZoneShot[]

  @@index([propertyId])
  @@map("shield_zones")
}

// Appareil permanent photographié UNE SEULE FOIS (bibliothèque
// réutilisable) — PLAQUE DE CUISSON, TÉLÉVISION, RÉFRIGÉRATEUR,
// MICRO-ONDES… QR unique REF-{KIND}-{code} + hash SHA-256 du
// fichier photo. Légal : « Photo de référence du JJ/MM/AAAA —
// réutilisée et re-validée [date] par [agent] (vidéo walkthrough) ».
model ShieldDevice {
  id             String   @id @default(cuid())
  propertyId     String   @map("property_id")
  name           String
  kind           String   @default("CUSTOM") // 'PLQ' | 'TV' | 'FRIGO' | 'MO' | 'CUSTOM'
  referencePhoto String   @map("reference_photo") // dataURL JPEG
  referenceHash  String   @map("reference_hash") // SHA-256 hex du fichier photo
  referenceCode  String   @unique @map("reference_code") // REF-PLQ-12126
  referenceDate  DateTime @map("reference_date") // date de la photo de référence
  sortOrder      Int      @default(0) @map("sort_order")

  property ShieldProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("shield_devices")
}

// Session CHECK_IN ou CHECK_OUT (90 secondes : 6 photos + 1 vidéo).
// Un CHECK_OUT est lié automatiquement au dernier CHECK_IN (PDF
// comparatif entrée vs sortie). Le certificat PDF final est envoyé
// AUTOMATIQUEMENT par email à l'hôte + à l'invité (s'il est renseigné).
model ShieldSession {
  id              String   @id @default(cuid())
  propertyId      String   @map("property_id")
  type            String   // 'CHECK_IN' | 'CHECK_OUT'
  agentName       String   @map("agent_name") // ex. « Agent Awa »
  guestName       String?  // nom de l'invité (optionnel — destinataire PDF)
  guestEmail      String?  @map("guest_email") // email invité (optionnel — PJ PDF)
  sessionRef      String   @unique @map("session_ref") // CHK-DAK-18102026-778
  linkedSessionId String?  @map("linked_session_id") // dernier CHECK_IN lié
  completedAt     DateTime @default(now()) @map("completed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  // ── PLANIFICATION « Ménage à faire » (Bouclier V2 — master prompt
  // client) : un séjour est créé À L'AVANCE par l'hôte (formulaire
  // nom/email invité + dates + téléphone cleaner). La session naît
  // A_VENIR avec un lien magique /s/[publicToken] pour l'agent ;
  // EN_RETARD est calculé à la volée (A_VENIR + date dépassée) ;
  // la capture complète (photos fantômes + vidéo, API session v5.1
  // existante) fera passer TERMINE — défaut 'TERMINE' = sessions
  // créées directement à la capture (rétro-compatible).
  status        String    @default("TERMINE") // A_VENIR | EN_RETARD | TERMINE | ANNULE
  scheduledDate DateTime? @map("scheduled_date") // date prévue du check-in / check-out
  cleanerPhone  String?   @map("cleaner_phone") // téléphone du cleaner (partage du lien)
  publicToken   String?   @unique @map("public_token") // lien magique cleaner (24 car.)
  // v4.167 — montant de la CAUTION protégée par le séjour (€, entier,
  // optionnel — saisi par l'hôte à la création du séjour, répliqué sur
  // les 2 sessions du pair CHECK_IN/CHECK_OUT). Alimente le badge
  // « 💰 X € de caution sécurisée » et le widget « Revenus protégés ».
  depositAmount Int?      @map("deposit_amount")

  property ShieldProperty   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  shots    ShieldZoneShot[]
  video    ShieldVideo?

  @@index([propertyId, type])
  @@map("shield_sessions")
}

// Photo d'une zone pour une session — même angle que la référence
// (fantôme) → comparable pixel par pixel avec le check-in opposé.
model ShieldZoneShot {
  id         String   @id @default(cuid())
  sessionId  String   @map("session_id")
  zoneId     String   @map("zone_id")
  zoneName   String   @map("zone_name") // dénormalisé (robustesse PDF)
  photo      String // dataURL JPEG compressée
  status     String   @default("IMPECCABLE") // 'IMPECCABLE' | 'A_NETTOYER' | 'DEGRADATION'
  comment    String?
  capturedAt DateTime @default(now()) @map("captured_at")

  session ShieldSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  zone    ShieldZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("shield_zone_shots")
}

// Vidéo walkthrough (jusqu'à 60 s) — preuve reine de re-validation
// globale de la bibliothèque. Stockée en BLOB (SQLite Bytes,
// déploiement sûr) et servie via /api/shield/video/[publicToken] ;
// le QR du PDF pointe vers /shield/video/[publicToken].
model ShieldVideo {
  id          String   @id @default(cuid())
  sessionId   String   @unique @map("session_id")
  publicToken String   @unique @map("public_token") // 24 car.
  mimeType    String   @default("video/webm") @map("mime_type")
  data        Bytes
  sizeBytes   Int      @map("size_bytes")
  durationSec Int      @default(60) @map("duration_sec")
  sha256      String // SHA-256 hex du fichier vidéo (intégrité)
  createdAt   DateTime @default(now()) @map("created_at")

  session ShieldSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("shield_videos")
}

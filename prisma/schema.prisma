// ==============================================================
// CONCIERGERIE HUB - PRISMA SCHEMA (SQLite - Dev Local)
// SaaS B2B pour hôtes Airbnb & gestionnaires de biens
// Version: 2.0.0 (ex QR Domotik — refonte B2B)
//
// NOTES :
// - SQLite ne supporte pas les enums Prisma natifs : les "enums"
//   sont des champs String dont les valeurs autorisées sont
//   documentées en commentaire (miroir PostgreSQL/Supabase à venir).
// - Catalogue de modules QR B2B :
//   'WIFI' | 'GUIDEBOOK' | 'UPSELLING' | 'CHECKOUT' | 'COMPLAINT' | 'PROVIDER_DIRECTORY'
// ==============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==============================================================
// TABLE 1: users
// ==============================================================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  fullName     String?  @map("full_name")
  passwordHash String?  @map("password_hash")
  role         String   @default("user")             // 'user' | 'superadmin'
  isActive     Boolean  @default(true) @map("is_active") // false = compte désactivé par le Superadmin (login bloqué)
  selectedPlan      String?   @map("selected_plan")      // 'airbnb_solo' | 'airbnb_pro' | 'agency' | 'free' — choisi avant paiement
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  // HOST-5 — Préférences de notifications du Dashboard Client
  // JSON : { [eventKey: string]: { email: boolean; push: boolean } }
  // Clés du catalogue : src/lib/notification-prefs.ts
  notificationPrefs Json?     @map("notification_prefs")
  // ÉTAPE 20 (V3) — Stripe Connect : compte destinataire de reversements
  // (hôte aujourd'hui null ; utile si l'invité paie le séjour directement)
  stripeAccountId   String?   @map("stripe_account_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  profile                       Profile?
  ownedProperties               Property[]
  propertyMemberships           PropertyMember[]
  createdBatches                QrBatch[]
  activatedPhysicalQrs          PhysicalQrCode[] @relation("UserActivatedQrs")
  claimedPlaqueQrs              PhysicalQrCode[] @relation("PlaqueClaimedByUser")
  activityLogEntries            ActivityLog[] @relation("ActivityLogUser")
  auditLogs                     AuditLog[]    @relation("AuditLogActor")
  pushSubscriptions             PushSubscription[]
  merchantProfile               Merchant?
  providerProfile               Provider?
  promoRedemptions              PromoRedemption[]
  reviews                       Review[]
  subscriptions                 Subscription[]     @relation("UserSubscriptions")
  activationLogs                ActivationLog[] @relation("ActivationLogUser")
  coupons                       Coupon[]             @relation("UserCoupons")
  couponScans                   CouponScan[]          @relation("CouponScanUser")
  chatMessages                  ChatMessage[]         @relation("ChatMessageSender")
  notifications                 Notification[]        @relation("UserNotifications")
  passwordResetTokens           PasswordResetToken[]
  // v4.69 « COMMISSION & FACTURATION MENSUELLE » — config paiement hôte.
  hostSettings                  HostSettings?
  commissionInvoices            MonthlyCommissionInvoice[]
  // v5.4 « COACH ROOMSCAN » — préférences du coach IA (relation 1:1).
  coachPreferences              CoachPreferences?
  // v4.96 « MÉNAGE » — interventions de ménage assignées au membre.
  assignedHousekeepingTasks     HousekeepingTask[] @relation("HousekeepingTaskAssignee")
  // v4.97 « MODULE STANDALONE ÉTAT DES LIEUX » — abonnement 99 €/an
  // (1:1) du module EDL indépendant du Hub.
  inspectionSubscription        InspectionSubscription?

  @@map("users")
}

// ==============================================================
// TABLE 2: profiles
// ==============================================================
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  avatarUrl String?  @map("avatar_url")
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ==============================================================
// TABLE 3: properties (ex "homes" — un bien géré par un hôte)
// ==============================================================
model Property {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  name      String                                   // Nom de l'annonce (ex: "Loft Canal Saint-Martin")
  propertyType String  @default("AIRBNB") @map("property_type") // 'AIRBNB' | 'BOOKING' | 'GITE' | 'CHAMBRE_HOTE'
  address   String?                                  // Adresse précise → géolocalisation des prestataires
  location  String?  // JSON string: {"lat": 48.8566, "lng": 2.3522} (SQLite; PostGIS GEOGRAPHY en Postgres)
  latitude  Float?                                   // Dénormalisé pour requêtes géo rapides
  longitude Float?
  isActive  Boolean  @default(true) @map("is_active")
  pinHash   String?  @map("pin_hash")                 // bcrypt du PIN 4 chiffres — "Mode Hôte" (protège l'accès tablette/QR)
  qrHubSlug String?  @unique @map("qr_hub_slug")     // ÉTAPE 12 : slug du Hub QR du bien → /hub/[qrHubSlug] (fallback des plaques)
  // ÉTAPE 19 (V3) — WHITE-LABEL : identité de marque de la conciergerie
  branding     Json?    // { logoUrl, primaryColor, companyName, welcomeMessage } (validé par src/lib/branding.ts)
  customDomain String?  @unique @map("custom_domain") // ex: "guests.ma-conciergerie.com" — CNAME vers le domaine de l'app
  customDomainVerified Boolean @default(false) @map("custom_domain_verified") // CNAME vérifié (resolveCname) — le middleware ne réécrit QUE les domaines vérifiés
  // =============================================================
  // DIGITAL CONCIERGE (V4.1) — modules enrichis du Hub Invité
  // JSON libres (SQLite) — formes validées côté app dans
  // src/components/guest-app (onglets Coffre-fort / Guide / Quartier / SOS)
  // =============================================================
  accessCodes   Json?    // Coffre-fort numérique : { building?, letterbox?, parking?, alarm?, safe?, note? } — tous String
  appliances    Json?    // Guide des appareils : [ { id, name, emoji?, instructions, videoUrl?, imageUrl? } ]
  localSpots    Json?    // Carte secrète de l'hôte : [ { id, name, category, lat, lng, address?, hostNote? } ]
  emergencyInfo Json?    // SOS : { hospital?, hospitalLat?, hospitalLng?, pharmacy?, police?, hostPhone?, commonIssues?: [ { id, title, instructions, imageUrl? } ] }
  // =============================================================
  // PREMIUM « CONCIERGERIE 5 ÉTOILES » (V5) — modules premium du
  // Hub Invité (expérience « wow » + upselling). JSON libres
  // (SQLite), formes validées côté serveur dans src/lib/concierge.ts
  // =============================================================
  premiumFeatures  Json?  // { videoWelcomeUrl?, enableLateCheckout?, lateCheckoutPrice?, enableReviewShield?, reviewUrl? }
  visualGuide      Json?  // Guide visuel d'arrivée pas à pas : [ { id, title, description?, imageUrl? } ]
  survivalKitItems Json?  // Kit de survie (objets oubliés) : [ { id, name, location? } ]
  // v4.31 « PHOTOS DE MON HUB » — personnalisation hôte des photos
  // pleine carte de l'Espace Invité : { [cardKey]: dataURL image/jpeg
  // (≤ ~500 Ko, redimensionnée côté client) }. Clés autorisées dans
  // src/lib/hub-photos.ts (HUB_PHOTO_KEYS). Absent = photo curated.
  hubPhotos        Json?
  // v4.32 « Prestataires autour » — liste d'ids de prestataires
  // DÉSACTIVÉS par l'hôte pour ce bien (string[]). Un prestataire
  // désactivé disparaît des services invités (hub + PWA) mais reste
  // visible avec son état dans les listes de gestion (mode hôte +
  // dashboard). Toggle : /api/public/hub/[slug]/providers-toggle (PIN)
  // et PATCH /api/airbnb/providers (session).
  disabledProviders Json?
  // v4.43 « ONGLET MÉNAGE DÉDIÉ » — checklist de nettoyage choisie par
  // l'hôte (dashboard → Ménage). null = checklist générale (défaut,
  // les 10 essentiels de src/lib/housekeeping.ts) ; sinon JSON array
  // de strings (1..20 items, ≤ 120 car. — ex. ["Lits refaits", …]).
  cleaningChecklist Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members           PropertyMember[]
  rooms             Room[]
  qrCodes           QrCode[]
  activityLogs      ActivityLog[]
  products          Product[]
  productInstances  ProductInstance[]
  merchant          Merchant?        @relation("PropertyMerchant")
  serviceRequests   ServiceRequest[] @relation("PropertyServiceRequests")
  scanLogs          ScanLog[]
  webhooks          Webhook[]
  propertyAutomations PropertyAutomation[]
  voiceMessages     VoiceMessage[]
  plaqueQrCodes     PhysicalQrCode[] @relation("PlaqueQrProperty")
  serviceOffers     ServiceOffer[]
  bookings          Booking[]
  automationRules   AutomationRule[]
  icalFeeds         PropertyIcalFeed[]
  guestComplaints   GuestComplaint[]  @relation("PropertyGuestComplaints")
  privateFeedbacks  PrivateFeedback[]
  guestSessions     GuestSession[]
  // v4.37 « MESSAGES VOCAUX DU HUB » — annonces audio de l'hôte pour ses
  // invités (bienvenue / veille du départ / jour du départ), 4 langues.
  hubVoiceMessages  HubVoiceMessage[]
  // v4.41 « MODE MÉNAGE » — rapports de nettoyage de l'équipe staff.
  cleaningReports   CleaningReport[]
  // v4.44 « DÉPART DÉFINITIF » — départs confirmés par les voyageurs
  // depuis le Hub (heure exacte enregistrée + alerte ménage envoyée).
  checkoutFinalEvents CheckoutFinalEvent[]
  // v4.50 « VERROUILLAGE DU HUB PAR CODE » — sessions d'accès invité
  // (1 code de réservation → 1 token par appareil, expiration auto).
  hubAccessSessions HubAccessSession[]
  // v4.50 « MINIBAR DE CONFIANCE » — commandes persistées, validation
  // d'inventaire d'arrivée et demandes de réapprovisionnement.
  minibarOrders     MinibarOrder[]
  minibarChecks     MinibarCheck[]
  minibarRestocks   MinibarRestockRequest[]
  // v4.52 « MIDDLE-STAY CARE » — réassorts/ménages en cours de séjour.
  middleStayRequests MiddleStayRequest[]
  // v4.52 « LIVRE D'OR VIVANT » — souvenirs des voyageurs (galerie modérée).
  guestMemories     GuestMemory[]
  // v4.53 « RAPPORT DE CHECK-OUT » — un récapitulatif auto par séjour.
  checkoutReports   CheckoutReport[]
  // v4.54 « PRESSING & BLANCHISSERIE EXPRESS » — commandes pressing invité.
  laundryOrders     LaundryOrder[]
  // v4.54 « ALERTES STOCK » — signalements d'équipe (serviettes, papier…).
  inventoryAlerts   InventoryAlert[]
  // v5.0 « ÉTAT DES LIEUX DE SORTIE » — inspection signée par l'invité avant
  // son départ, avec photos, inventaire rendu et URL publique de preuve.
  checkOutInspections CheckOutInspection[]
  // v4.69 « MES PRESTATAIRES » — prestataires ajoutés manuellement par
  // l'hôte (annuaire privé du bien, hors annuaire plateforme).
  hostProviders     HostProvider[]
  // v4.74 « SMART PROMPTS » — notifications temporelles configurables
  // (petit-déjeuner / déjeuner / dîner / veille de départ) + journal.
  notificationSettings NotificationSettings?
  notificationLogs  NotificationLog[]
  // v4.74 « BOUTIQUE DE SOUVENIRS » — produits vendus au départ + commandes.
  souvenirProducts  SouvenirProduct[]
  souvenirOrders    SouvenirOrder[]
  // v5.4 « COACH ROOMSCAN » — insights du moteur d'analyse + analytics.
  dashboardInsights DashboardInsight[]
  coachAnalytics    CoachAnalytics[]
  // v4.95 « DEMANDES PARTICULIÈRES » — demandes invités (lit d'appoint,
  // lit bébé, siège bébé…) depuis le Hub, traitées par l'hôte.
  specialRequests   SpecialRequest[]
  // v4.96 « MÉNAGE — INTERVENTIONS PLANIFIÉES » — créneaux de ménage
  // générés automatiquement entre le départ et l'arrivée suivante.
  housekeepingTasks HousekeepingTask[]

  @@index([ownerId])
  @@index([propertyType])
  @@index([qrHubSlug])
  @@map("properties")
}

// ==============================================================
// TABLE v4.41: cleaning_reports (MODE MÉNAGE — bouton Staff du Hub)
// La femme de ménage scanne la même plaque, entre via « Mode Ménage »
// (code staff), coche la checklist de nettoyage, uploade les photos de
// l'appartement PROPRE et valide ses heures d'arrivée/départ. L'hôte
// reçoit la notification « L'appartement est prêt pour le prochain
// client ». Un GuestComplaint (CLEANING, RESOLVED, photos) est aussi
// créé pour rendre le rapport visible dans Messages côté dashboard.
// photos : JSON string de dataURL — ≤ 6 photos, ≤ 500 KB / photo.
// ==============================================================
model CleaningReport {
  id            String    @id @default(cuid())
  propertyId    String    @map("property_id")
  staffName     String?                                  // prénom de l'agent (optionnel)
  checklistJson String    @default("[]") @map("checklist_json") // [{ label, done }]
  photos        String    @default("[]")                 // JSON dataURLs (appartement propre)
  // v4.43 — vocal laissé par la femme de ménage EN MÊME TEMPS que les
  // preuves (« vocale accompagnant les preuves ») : base64 ≤ ~1 Mo,
  // mime allowlist (webm/mp4/ogg…), durée ≤ 90 s. null = pas de vocal.
  voiceData     String?   @map("voice_data")
  voiceMime     String?   @map("voice_mime")
  voiceDurationSec Int?   @default(0) @map("voice_duration_sec")
  startedAt     DateTime? @map("started_at")             // heure d'arrivée du staff
  endedAt       DateTime? @map("ended_at")               // heure de validation (= départ)
  // v4.50 « HORODATAGE & GÉOLOCALISATION DU MÉNAGE » — coordonnées GPS
  // capturées sur le téléphone du staff à l'OUVERTURE du mode (arrivée)
  // et à la VALIDATION (départ). L'hôte voit le temps d'intervention
  // précis + le lieu (preuve de présence sur site entre 2 réservations).
  startLat      Float?    @map("start_lat")
  startLng      Float?    @map("start_lng")
  endLat        Float?    @map("end_lat")
  endLng        Float?    @map("end_lng")
  createdAt     DateTime  @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@map("cleaning_reports")
}

// ==============================================================
// TABLE v4.96: housekeeping_tasks (MÉNAGE — INTERVENTIONS PLANIFIÉES)
// Le cœur du business de l'hôte : chaque séjour CONFIRMÉ génère
// AUTOMATIQUEMENT une intervention de ménage au créneau situé entre
// le check-out du séjour et le check-in du séjour suivant sur le
// même bien (ou check-out + 4 h si pas de suite connue).
//
//   scheduledAt/scheduledEndAt : créneau PRÉVU (planifié)
//   startedAt/endedAt          : heures RÉELLES (staff ou hôte)
//   status : 'PENDING' (à faire) | 'IN_PROGRESS' (en cours) | 'DONE'
//   assigneeId : membre de l'équipe (User) chargé de l'intervention
//   reportId   : CleaningReport lié (preuves photos + vocal + GPS)
//   bookingId  : séjour déclencheur (1 ménage de sortie max / séjour,
//                @@unique — null pour les interventions ad-hoc)
//
// Synchronisation : la validation du rapport staff dans le Hub
// (/api/public/hub/[slug]/cleaning) passe la tâche à DONE et bascule
// Booking.cleaningStatus = 'DONE' — une seule source de vérité.
// ==============================================================
model HousekeepingTask {
  id             String    @id @default(cuid())
  propertyId     String    @map("property_id")
  bookingId      String?   @map("booking_id")
  scheduledAt    DateTime  @map("scheduled_at")
  scheduledEndAt DateTime? @map("scheduled_end_at")
  assigneeId     String?   @map("assignee_id")
  status         String    @default("PENDING") // 'PENDING' | 'IN_PROGRESS' | 'DONE'
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  reportId       String?   @map("report_id")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  assignee User?    @relation("HousekeepingTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([bookingId])
  @@index([propertyId, scheduledAt])
  @@index([status])
  @@index([assigneeId])
  @@map("housekeeping_tasks")
}

// ==============================================================
// TABLE v4.44: checkout_final_events (DÉPART DÉFINITIF DU HUB)
// Le voyageur appuie sur « 🚪 Départ définitif » dans son Hub :
//   1. heure exacte du départ enregistrée (departedAt) ;
//   2. alerte AUTOMATIQUE à l'équipe de ménage (hôte + managers via
//      cloche + email + push — « Les voyageurs ont quitté le
//      logement. Vous pouvez intervenir. ») ;
//   3. le voyageur est redirigé vers le recueil d'avis (Review
//      Booster 5 étoiles — pendant qu'il est encore positif).
// bookingId optionnel (rattaché si fourni et re-validé par bien).
// ==============================================================
model CheckoutFinalEvent {
  id          String   @id @default(cuid())
  propertyId  String   @map("property_id")
  bookingId   String?  @map("booking_id")
  guestName   String?  @map("guest_name")
  departedAt  DateTime @map("departed_at")      // heure exacte du départ confirmé
  // Traçabilité de l'alerte ménage : 'SENT' (notifications créées)
  // | 'NO_AUDIENCE' (aucun destinataire trouvé — jamais bloquant).
  staffAlertStatus String @default("SENT") @map("staff_alert_status")
  // v4.54 « ALERTE VOCALE & CHECKLIST DE DÉPART » — checklist finale
  // confirmée par l'invité (JSON [{label,done}]) — null = départ sans
  // checklist (séjours antérieurs).
  checklistJson String? @map("checklist_json")
  createdAt   DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, departedAt])
  @@map("checkout_final_events")
}

// ==============================================================
// TABLE Hub: guest_complaints (Hub QR — réclamations écrites invité)
// Formulaire « Signaler un problème » du Hub public (/hub/[slug]).
// category : 'PLUMBING' | 'ELECTRICAL' | 'CLEANING' | 'OTHER'
// photos   : JSON string d'images base64 (dataURL) — ≤ 500 KB / photo
// status   : 'OPEN' | 'RESOLVED' (côté hôte, mode Hôte du Hub)
// isRead   : notification vue par l'hôte (badge rouge éteint même
//            si la réclamation reste ouverte — v4.32)
// ==============================================================
model GuestComplaint {
  id          String   @id @default(cuid())
  propertyId  String   @map("property_id")
  category    String   @default("OTHER") // v4.41 : + 'BREAKAGE' (casse invité 1 clic) — v4.53 : SOS breakage → 'BREAKAGE' (fiche assurance)
  description String
  photos      String   @default("[]")
  isUrgent    Boolean  @default(false) @map("is_urgent")
  guestName   String?                                   // nom laissé par l'invité (optionnel)
  status      String   @default("OPEN")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  property Property @relation("PropertyGuestComplaints", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([createdAt])
  @@map("guest_complaints")
}

// ==============================================================
// TABLE 38: automation_rules (ÉTAPE 13 V2 — Automatisations)
// Catalogue fixe de règles trigger → action par bien.
// `key`     : identifiant du catalogue (voir src/lib/automations.ts)
//   'booking_created_team'   | 'booking_created_cleaning'
//   | 'cleaning_done_owner'  | 'checkin_today_reminder'
//   | 'checkout_today_reminder' | 'maintenance_alert'
//   | 'member_accepted_owner'
// `trigger` : 'BOOKING_CREATED' | 'CLEANING_DONE' | 'CHECK_IN_TODAY'
//   | 'CHECK_OUT_TODAY' | 'MAINTENANCE_REQUESTED' | 'MEMBER_ACCEPTED'
// `action`  : audience notifiée — 'NOTIFY_OWNERS' | 'NOTIFY_CLEANERS'
//   | 'NOTIFY_TEAM' | 'NOTIFY_MAINTENANCE'
// Les rappels quotidiens (CHECK_IN_TODAY / CHECK_OUT_TODAY) sont
// évalués en lazy (à la lecture) ; `lastRunAt` garantit 1 run/jour.
// ==============================================================
model AutomationRule {
  id         String    @id @default(cuid())
  propertyId String    @map("property_id")
  key        String
  trigger    String
  action     String
  isActive   Boolean   @default(true) @map("is_active")
  lastRunAt  DateTime? @map("last_run_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, key])
  @@index([propertyId])
  @@index([trigger, isActive])
  @@map("automation_rules")
}

// ==============================================================
// TABLE 4: property_members (équipe d'un bien) — ÉTAPE 12 V2
// Rôles canoniques V2 (MemberRole) :
//   'OWNER'       — accès total (propriétaire)
//   'MANAGER'     — gère bookings, messages, prestataires
//   'CLEANER'     — voit uniquement le planning ménage
//   'MAINTENANCE' — voit uniquement les réclamations techniques
// Legacy V1 tolérés & mappés : 'owner'→OWNER, 'cohost'→MANAGER,
// 'member'→MANAGER, 'staff'→MAINTENANCE, 'cleaner'→CLEANER
// ==============================================================
model PropertyMember {
  id       String   @id @default(cuid())
  propertyId String @map("property_id")
  userId   String   @map("user_id")
  role     String   @default("MANAGER")             // 'OWNER' | 'MANAGER' | 'CLEANER' | 'MAINTENANCE' (+ legacy mappés)
  nickname String?
  permissions String? // JSON string : permissions granulaires (ex: {"managePricing":true}) — PostgreSQL Json en prod
  invitedAt DateTime @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")           // null = invitation en attente (accès bloqué tant que non acceptée)
  joinedAt DateTime @default(now()) @map("joined_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([propertyId])
  @@index([userId])
  @@index([role])
  @@map("property_members")
}

// ==============================================================
// TABLE 5: rooms
// ==============================================================
model Room {
  id        String   @id @default(cuid())
  propertyId String  @map("property_id")
  name      String
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  qrCodes  QrCode[]

  @@index([propertyId])
  @@map("rooms")
}

// ==============================================================
// TABLE 6: qr_codes (Dynamiques - V1)
// `type` : catalogue B2B :
//   'WIFI' | 'GUIDEBOOK' | 'UPSELLING' | 'CHECKOUT' | 'COMPLAINT' | 'PROVIDER_DIRECTORY'
//   (legacy V1/V2 conservé en base pour migration douce : 'wifi', 'note', 'doorbell', 'guestbook', …)
// ==============================================================
model QrCode {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  roomId     String?  @map("room_id")
  name       String
  type       String
  publicSlug String?  @unique @map("public_slug")
  isActive   Boolean  @default(true) @map("is_active")
  isPrivate  Boolean  @default(false) @map("is_private")
  pinCode    String?  @map("pin_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  property          Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room              Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  content           QrContent?
  physicalQrCodes   PhysicalQrCode[]
  guestbookEntries  GuestbookEntry[]
  activityLogs      ActivityLog[]
  serviceRequests   ServiceRequest[]
  emergencyQrCode   EmergencyQrCode?
  scanLogs          ScanLog[]

  @@index([propertyId])
  @@index([roomId])
  @@index([type])
  @@index([isActive])
  @@map("qr_codes")
}

// ==============================================================
// TABLE 7: qr_contents
// ==============================================================
model QrContent {
  id          String   @id @default(cuid())
  qrCodeId    String   @unique @map("qr_code_id")
  contentJson String   @default("{}") @map("content_json")
  updatedAt   DateTime @updatedAt @map("updated_at")

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@map("qr_contents")
}

// ==============================================================
// TABLE 8: qr_batches
// ==============================================================
model QrBatch {
  id           String   @id @default(cuid())
  quantity     Int
  designConfig String   @default("{}") @map("design_config")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  user            User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  physicalQrCodes PhysicalQrCode[]

  @@index([createdBy])
  @@map("qr_batches")
}

// ==============================================================
// TABLE 9: physical_qr_codes
// ==============================================================
model PhysicalQrCode {
  id                 String    @id @default(cuid())
  batchId            String    @map("batch_id")
  activationCode     String    @unique @map("activation_code")
  status             String    @default("inactive") // 'inactive' | 'active' | 'lost' | 'cancelled'
  createdAt          DateTime  @default(now()) @map("created_at")
  activatedByUserId  String?   @map("activated_by_user_id")
  activatedAt        DateTime? @map("activated_at")
  dynamicQrCodeId    String?   @map("dynamic_qr_code_id")
  designConfig       String    @default("{}") @map("design_config")
  // ── Scan-to-Onboard & QR Hub ──
  setupToken         String?   @unique @map("setup_token")            // token unique pour /setup/[token] (ex: "SETUP-7K9M2X")
  isClaimed          Boolean   @default(false) @map("is_claimed")     // true = plaque liée à un compte
  hubSlug            String?   @unique @map("hub_slug")               // slug public pour /hub/[slug] (ex: "loft-saint-martin-7kx")
  claimedByUserId    String?   @map("claimed_by_user_id")             // utilisateur qui a claimé
  claimedAt          DateTime? @map("claimed_at")
  propertyId         String?   @map("property_id")                    // bien lié à cette plaque

  // Relations
  batch          QrBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  activatedBy    User?      @relation("UserActivatedQrs", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  claimedBy      User?      @relation("PlaqueClaimedByUser", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  dynamicQrCode  QrCode?    @relation(fields: [dynamicQrCodeId], references: [id], onDelete: SetNull)
  activationLogs ActivationLog[]
  property       Property?  @relation("PlaqueQrProperty", fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([status])
  @@index([activatedByUserId])
  @@index([dynamicQrCodeId])
  @@index([isClaimed])
  @@index([claimedByUserId])
  @@index([propertyId])
  @@index([setupToken])
  @@map("physical_qr_codes")
}

// ==============================================================
// TABLE 10: activation_logs
// ==============================================================
model ActivationLog {
  id                String   @id @default(cuid())
  physicalQrCodeId  String   @map("physical_qr_code_id")
  userId            String?  @map("user_id")
  action            String   // 'activated' | 'deactivated' | 'marked_lost'
  createdAt         DateTime @default(now()) @map("created_at")

  physicalQrCode PhysicalQrCode @relation(fields: [physicalQrCodeId], references: [id], onDelete: Cascade)
  user           User?           @relation("ActivationLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([physicalQrCodeId])
  @@index([userId])
  @@index([action])
  @@map("activation_logs")
}

// ==============================================================
// TABLE 11: guestbook_entries (Livre d'or — utile aux hôtes)
// ==============================================================
model GuestbookEntry {
  id        String   @id @default(cuid())
  qrCodeId  String   @map("qr_code_id")
  guestName String   @map("guest_name")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([createdAt])
  @@map("guestbook_entries")
}

// ==============================================================
// TABLE 12: activity_logs
// ==============================================================
model ActivityLog {
  id          String   @id @default(cuid())
  propertyId  String   @map("property_id")
  qrCodeId    String?  @map("qr_code_id")
  userId      String?  @map("user_id")
  actionType  String   @map("action_type")
  detailsJson String   @default("{}") @map("details_json")
  createdAt   DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  qrCode   QrCode?  @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  user     User?    @relation("ActivityLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([qrCodeId])
  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
  @@map("activity_logs")
}

// ==============================================================
// TABLE 13: products (Stock — consommables & linge du bien)
// isOnShoppingList = liste de réapprovisionnement (ménage/consommables)
// ==============================================================
model Product {
  id                String   @id @default(cuid())
  propertyId        String   @map("property_id")
  name              String
  category          String?
  minStockThreshold Int      @default(1) @map("min_stock_threshold")
  currentStock      Int      @default(0) @map("current_stock")
  isOnShoppingList  Boolean  @default(false) @map("is_on_shopping_list")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  productInstances ProductInstance[]

  @@index([propertyId])
  @@index([category])
  @@index([isOnShoppingList])
  @@map("products")
}

// ==============================================================
// TABLE 14: product_instances
// ==============================================================
model ProductInstance {
  id           String    @id @default(cuid())
  productId    String    @map("product_id")
  propertyId   String    @map("property_id")
  purchaseDate DateTime? @map("purchase_date")
  expiryDate   DateTime? @map("expiry_date")
  status       String    @default("fresh")
  createdAt    DateTime  @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([propertyId])
  @@index([status])
  @@index([expiryDate])
  @@map("product_instances")
}

// ==============================================================
// TABLE 15: push_subscriptions
// ==============================================================
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dhKey String   @map("p256dh_key")
  authKey   String   @map("auth_key")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ==============================================================
// TABLE 16: merchants (Marketplace)
// ==============================================================
model Merchant {
  id                       String    @id @default(cuid())
  userId                   String?   @unique @map("user_id")
  propertyId               String?   @unique @map("property_id")
  name                     String
  category                 String?
  description              String?
  address                  String?
  location                 String?
  phone                    String?
  website                  String?
  openingHours             String    @default("{}") @map("opening_hours")
  logoUrl                  String?   @map("logo_url")
  subscriptionTier         String    @default("free") @map("subscription_tier")
  subscriptionExpiresAt    DateTime? @map("subscription_expires_at")
  stripeCustomerId         String?   @map("stripe_customer_id")
  isVerified               Boolean   @default(false) @map("is_verified")
  ratingAvg                Float     @default(0) @map("rating_avg")
  totalReviews             Int       @default(0) @map("total_reviews")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  property       Property?        @relation("PropertyMerchant", fields: [propertyId], references: [id], onDelete: SetNull)
  promos         Promo[]
  subscriptions  Subscription[]   @relation("MerchantSubscriptions")
  flashSales     FlashSale[]
  coupons        Coupon[]
  couponScans    CouponScan[]
  merchantPhotos MerchantPhoto[]

  @@index([category])
  @@index([subscriptionTier])
  @@index([isVerified])
  @@index([isActive])
  @@map("merchants")
}

// ==============================================================
// TABLE 17: promos (Marketplace)
// ==============================================================
model Promo {
  id                      String    @id @default(cuid())
  merchantId              String?   @map("merchant_id")
  source                  String    @default("local")
  title                   String
  description             String?
  imageUrl                String?   @map("image_url")
  originalPrice           Float?    @map("original_price")
  promoPrice              Float?    @map("promo_price")
  validFrom               DateTime? @map("valid_from")
  validUntil              DateTime? @map("valid_until")
  keywords                String    @default("[]")
  category                String?
  isFlashSale             Boolean   @default(false) @map("is_flash_sale")
  flashSaleTriggeredAt    DateTime? @map("flash_sale_triggered_at")
  flashSaleCost           Float?    @map("flash_sale_cost")
  viewsCount              Int       @default(0) @map("views_count")
  redemptionsCount        Int       @default(0) @map("redemptions_count")
  createdAt               DateTime  @default(now()) @map("created_at")

  merchant    Merchant?          @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  redemptions PromoRedemption[]
  flashSales  FlashSale[]
  couponList  Coupon[]           @relation("CouponPromo")

  @@index([merchantId])
  @@index([category])
  @@index([source])
  @@index([validFrom])
  @@index([validUntil])
  @@index([isFlashSale])
  @@map("promos")
}

// ==============================================================
// TABLE 18: promo_redemptions (Marketplace)
// ==============================================================
model PromoRedemption {
  id               String   @id @default(cuid())
  promoId          String   @map("promo_id")
  userId           String   @map("user_id")
  redeemedAt       DateTime @default(now()) @map("redeemed_at")
  commissionAmount Float    @default(0) @map("commission_amount")

  promo Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promoId])
  @@index([userId])
  @@index([redeemedAt])
  @@map("promo_redemptions")
}

// ==============================================================
// TABLE 19: scraping_jobs (Marketplace)
// ==============================================================
model ScrapingJob {
  id              String    @id @default(cuid())
  source          String
  storeLocation   String?   @map("store_location")
  status          String    @default("running")
  productsScraped Int       @default(0) @map("products_scraped")
  errorMessage    String?   @map("error_message")
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  @@index([status])
  @@index([startedAt])
  @@map("scraping_jobs")
}

// ==============================================================
// TABLE 20: providers (Prestataires de la conciergerie)
// audience : 'OWNER_SERVICE' (ménage, plomberie → services à l'hôte)
//            'GUEST_EXPERIENCE' (petit-déj, sommelier → expérience invité)
// Géolocalisation : latitude/longitude + serviceRadiusKm (rayon d'intervention)
// ==============================================================
model Provider {
  id                       String    @id @default(cuid())
  userId                   String    @unique @map("user_id")
  businessName             String    @map("business_name")
  category                 String
  subcategory              String?   @map("subcategory")
  description              String?
  location                 String?                                  // Adresse/ville affichée
  latitude                 Float?                                   // Géoloc précise (matching avec les biens)
  longitude                Float?
  serviceRadiusKm          Int       @default(10) @map("service_radius_km")
  audience                 String    @default("OWNER_SERVICE")      // 'OWNER_SERVICE' | 'GUEST_EXPERIENCE'
  hourlyRate               Float?    @map("hourly_rate")
  isUrgentAvailable        Boolean   @default(false) @map("is_urgent_available")
  isVerified               Boolean   @default(false) @map("is_verified")
  verificationDocuments    String    @default("[]") @map("verification_documents")
  portfolioImages          String    @default("[]") @map("portfolio_images")
  subscriptionStatus       String    @default("free") @map("subscription_status")
  subscriptionExpiresAt    DateTime? @map("subscription_expires_at")
  stripeCustomerId         String?   @map("stripe_customer_id")
  // ÉTAPE 20 (V3) — Stripe Connect Express : compte destinataire des
  // paiements de commandes (destination charge + application_fee_amount).
  stripeAccountId          String?   @map("stripe_account_id")
  stripeChargesEnabled     Boolean   @default(false) @map("stripe_charges_enabled") // capacité d'encaissement confirmée par Stripe
  stripeOnboardedAt        DateTime? @map("stripe_onboarded_at")
  ratingAvg                Float     @default(0) @map("rating_avg")
  totalReviews             Int       @default(0) @map("total_reviews")
  responseTimeMinutes      Int?      @map("response_time_minutes")
  totalJobsCompleted       Int       @default(0) @map("total_jobs_completed")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        Service[]
  serviceRequests ServiceRequest[] @relation("ProviderServiceRequests")
  reviews         Review[]
  subscriptions   Subscription[]   @relation("ProviderSubscriptions")
  serviceOrders   ServiceOrder[]
  serviceOffers   ServiceOffer[]
  payouts         Payout[]

  @@index([category])
  @@index([audience])
  @@index([latitude])
  @@index([longitude])
  @@index([subcategory])
  @@index([subscriptionStatus])
  @@index([isVerified])
  @@index([isActive])
  @@index([isUrgentAvailable])
  @@map("providers")
}

// ==============================================================
// TABLE 21: services (offres d'un prestataire)
// ==============================================================
model Service {
  id              String  @id @default(cuid())
  providerId      String  @map("provider_id")
  name            String
  description     String?
  basePrice       Float   @default(0) @map("base_price")
  priceUnit       String  @default("flat_rate") @map("price_unit") // 'hour' | 'flat_rate' | 'estimate'
  durationMinutes Int?    @map("duration_minutes")
  isUrgent        Boolean @default(false) @map("is_urgent")
  isActive        Boolean @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  provider        Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]

  @@index([providerId])
  @@index([isActive])
  @@index([isUrgent])
  @@map("services")
}

// ==============================================================
// TABLE 22: service_requests (demandes de service)
// ==============================================================
model ServiceRequest {
  id               String    @id @default(cuid())
  propertyId       String    @map("property_id")
  providerId       String    @map("provider_id")
  serviceId        String?   @map("service_id")
  qrCodeId         String?   @map("qr_code_id")
  status           String    @default("pending")
  description      String?
  photos           String    @default("[]")
  preferredDate    DateTime? @map("preferred_date")
  urgencyLevel     String    @default("normal") @map("urgency_level")
  address          String?
  finalPrice       Float?    @map("final_price")
  commissionAmount Float?    @map("commission_amount")
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  property  Property       @relation("PropertyServiceRequests", fields: [propertyId], references: [id], onDelete: Cascade)
  provider  Provider       @relation("ProviderServiceRequests", fields: [providerId], references: [id], onDelete: Cascade)
  service   Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  qrCode    QrCode?        @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  reviews   Review[]
  chatMessages ChatMessage[]

  @@index([propertyId])
  @@index([providerId])
  @@index([serviceId])
  @@index([qrCodeId])
  @@index([status])
  @@index([urgencyLevel])
  @@index([createdAt])
  @@map("service_requests")
}

// ==============================================================
// TABLE 23: reviews
// ==============================================================
model Review {
  id                String   @id @default(cuid())
  serviceRequestId  String   @map("service_request_id")
  providerId        String   @map("provider_id")
  userId            String   @map("user_id")
  rating            Int
  comment           String?
  createdAt         DateTime @default(now()) @map("created_at")

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
  @@index([providerId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

// ==============================================================
// TABLE 24: emergency_qr_codes
// ==============================================================
model EmergencyQrCode {
  id                String  @id @default(cuid())
  qrCodeId          String  @unique @map("qr_code_id")
  emergencyCategory String  @map("emergency_category")
  equipmentInfo     String  @default("{}") @map("equipment_info")
  isActive          Boolean @default(true) @map("is_active")

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([emergencyCategory])
  @@index([isActive])
  @@map("emergency_qr_codes")
}

// ==============================================================
// TABLE 25: subscriptions (Monétisation)
// plan : 'airbnb_solo' | 'airbnb_pro' | 'agency' | 'free' | 'pro_merchant' | 'business_merchant'
// ==============================================================
model Subscription {
  id                    String    @id @default(cuid())
  subscriberId          String?   @map("subscriber_id")                    // FK merchant/provider — null pour un abonnement HÔTE (cf. userId)
  subscriberType        String    @map("subscriber_type") // 'user' | 'merchant' | 'provider'
  userId                String?   @map("user_id")                          // FK dédiée pour les abonnements HÔTE (Stripe Étape 10)
  plan                  String
  amount                Float
  currency              String    @default("EUR")
  billingCycle          String    @default("annual") @map("billing_cycle") // 'monthly' | 'annual'
  maxProperties         Int       @default(1) @map("max_properties")      // nombre de biens inclus (airbnb_pro = 3)
  stripeSubscriptionId  String?   @map("stripe_subscription_id")
  // v4.95 — PayPal pour les ABONNEMENTS PLATEFORME (premium / mise en
  // avant) ; Stripe reste dédié aux paiements HÔTES (minibar, services).
  paypalSubscriptionId  String?   @map("paypal_subscription_id")
  paymentProvider       String    @default("stripe") @map("payment_provider") // 'stripe' | 'paypal'
  status                String    @default("active")                      // 'active' | 'past_due' | 'cancelled' | 'trialing'
  currentPeriodStart    DateTime? @map("current_period_start")
  currentPeriodEnd      DateTime? @map("current_period_end")
  createdAt             DateTime  @default(now()) @map("created_at")

  merchant Merchant? @relation("MerchantSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  provider Provider? @relation("ProviderSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  user     User?     @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
  @@index([subscriberType])
  @@index([userId])
  @@index([status])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

// ==============================================================
// TABLE 26: transactions (Monétisation)
// ==============================================================
model Transaction {
  id              String   @id @default(cuid())
  type            String
  payerId         String?  @map("payer_id")
  receiverId      String?  @map("receiver_id")
  amount          Float
  currency        String   @default("EUR")
  // ÉTAPE 20 (V3) — Connect : commission plateforme retenue sur ce
  // paiement (null = encaissement intégral plateforme, modèle 17.6)
  platformFee     Float?   @map("platform_fee")
  stripePaymentId String?  @map("stripe_payment_id")
  status          String   @default("pending")
  referenceId     String?  @map("reference_id")
  createdAt       DateTime @default(now()) @map("created_at")

  flashSales  FlashSale[]  @relation("FlashSaleTransaction")
  couponScans CouponScan[] @relation("CouponScanTransaction")

  @@index([type])
  @@index([payerId])
  @@index([receiverId])
  @@index([status])
  @@index([stripePaymentId])
  @@index([createdAt])
  @@map("transactions")
}

// ==============================================================
// TABLE 27: flash_sales (Marketplace)
// ==============================================================
model FlashSale {
  id                    String    @id @default(cuid())
  promoId               String    @map("promo_id")
  merchantId            String    @map("merchant_id")
  title                 String
  description           String?
  imageUrl              String?   @map("image_url")
  originalPrice         Float?    @map("original_price")
  flashPrice            Float     @map("flash_price")
  geofenceRadiusMeters  Int       @default(500) @map("geofence_radius_meters")
  startsAt              DateTime  @map("starts_at")
  endsAt                DateTime  @map("ends_at")
  maxRedemptions        Int?      @map("max_redemptions")
  currentRedemptions    Int       @default(0) @map("current_redemptions")
  status                String    @default("scheduled") // 'scheduled' | 'active' | 'expired' | 'cancelled'
  costEuros             Float     @default(0.5) @map("cost_euros")
  transactionId         String?   @map("transaction_id")
  pushSent              Boolean   @default(false) @map("push_sent")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  promo       Promo        @relation(fields: [promoId], references: [id], onDelete: Cascade)
  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation("FlashSaleTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  coupons     Coupon[]

  @@index([promoId])
  @@index([merchantId])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@map("flash_sales")
}

// ==============================================================
// TABLE 28: coupons (Marketplace)
// ==============================================================
model Coupon {
  id              String    @id @default(cuid())
  // Optionnel : un coupon créé par la plateforme (console superadmin)
  // n'appartient pas forcément à un marchand.
  merchantId      String?   @map("merchant_id")
  promoId         String?   @map("promo_id")
  flashSaleId     String?   @map("flash_sale_id")
  userId          String    @map("user_id")
  code            String    @unique
  qrCodeData      String    @map("qr_code_data")
  discountType    String    @default("percentage") @map("discount_type") // 'percentage' | 'fixed' | 'bogof'
  discountValue   Float     @map("discount_value")
  maxUses         Int       @default(1) @map("max_uses")
  currentUses     Int       @default(0) @map("current_uses")
  validFrom       DateTime? @map("valid_from")
  validUntil      DateTime? @map("valid_until")
  status          String    @default("active") // 'active' | 'used' | 'expired' | 'cancelled'
  commissionRate  Float     @default(5.0) @map("commission_rate")
  createdAt       DateTime  @default(now()) @map("created_at")

  merchant  Merchant?    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  promo     Promo?       @relation("CouponPromo", fields: [promoId], references: [id], onDelete: SetNull)
  flashSale FlashSale?   @relation(fields: [flashSaleId], references: [id], onDelete: SetNull)
  user      User         @relation("UserCoupons", fields: [userId], references: [id], onDelete: Cascade)
  scans     CouponScan[]

  @@index([merchantId])
  @@index([userId])
  @@index([promoId])
  @@index([flashSaleId])
  @@index([code])
  @@index([status])
  @@map("coupons")
}

// ==============================================================
// TABLE 29: coupon_scans (Marketplace)

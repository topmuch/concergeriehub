  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  scannedBy   User?        @relation("CouponScanUser", fields: [scannedByUserId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation("CouponScanTransaction", fields: [transactionId], references: [id], onDelete: SetNull)

